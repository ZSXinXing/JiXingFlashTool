<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:converter="clr-namespace:JiXingFlashTool.Converters" xmlns:control="clr-namespace:JiXingFlashTool.Control" xmlns:lang="clr-namespace:LanguageCore;assembly=LanguageCore" xmlns:local="clr-namespace:JiXingFlashTool.Utils" xmlns:odin="clr-namespace:JiXingFlashTool.Views.Odin" xmlns:viewModel="clr-namespace:JiXingFlashTool.ViewModels">
<converter:VisibilityBoolConverter x:Key="VisibilityBoolConverter" />
        <converter:InverseVisibilityBoolConverter x:Key="InverseVisibilityBoolConverter" />
        <converter:BooleanToGridLengthConverter x:Key="BooleanToGridLengthConverter" />
        <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#FAFAFA" />
        <SolidColorBrush x:Key="SidebarBorderBrush" Color="#E0E0E0" />
        <SolidColorBrush x:Key="PageBackgroundBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="PagePanelBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="PrimaryBrush" Color="#2196F3" />
        <SolidColorBrush x:Key="PrimarySoftBrush" Color="#E3F2FD" />
        <SolidColorBrush x:Key="WarningBrush" Color="#FF9800" />
        <SolidColorBrush x:Key="DangerBrush" Color="#F44336" />
        <SolidColorBrush x:Key="PurpleBrush" Color="#9C27B0" />
        <SolidColorBrush x:Key="SidebarSelectedBackgroundBrush" Color="#EBF0FF" />
        <SolidColorBrush x:Key="SidebarSelectedForegroundBrush" Color="#5C82FD" />
        <SolidColorBrush x:Key="TextBrush" Color="#333333" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="#999999" />
        <SolidColorBrush x:Key="BorderBrush" Color="#E0E0E0" />
        <SolidColorBrush x:Key="LightInputBrush" Color="#FAFAFA" />

        <Style x:Key="TwrpDropDownMenuItemStyle" TargetType="Button">
            <Setter Property="Height" Value="24.5" />
            <Setter Property="Padding" Value="9,0,10,0" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="RootBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Stretch"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RootBorder" Property="Background" Value="#EEF4FF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="RootBorder" Property="Background" Value="#E4EDFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TwrpDropDownPopupBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#E6E8EF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="6" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="16"
                                      Color="#22000000"
                                      Direction="270"
                                      Opacity="0.18"
                                      ShadowDepth="2" />
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TwrpDropDownToggleButtonStyle" TargetType="ToggleButton">
            <Setter Property="MinWidth" Value="75.25" />
            <Setter Property="Height" Value="24.5" />
            <Setter Property="Padding" Value="10.5,0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="RootBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3.5"
                                SnapsToDevicePixels="True">
                            <Grid Margin="{TemplateBinding Padding}"
                                  UseLayoutRounding="True">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="12.25" />
                                    <ColumnDefinition Width="10.5" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="7" />
                                    <ColumnDefinition Width="10.5" />
                                </Grid.ColumnDefinitions>
                                <Image Width="12.25"
                                       Height="12.25"
                                       Source="{TemplateBinding Tag}"
                                       Grid.Column="0"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Margin="0" />
                                <TextBlock Text="{TemplateBinding Content}"
                                           Grid.Column="2"
                                           HorizontalAlignment="Left"
                                           VerticalAlignment="Center"
                                           TextAlignment="Center"
                                           Foreground="{TemplateBinding Foreground}"
                                           FontSize="{TemplateBinding FontSize}"
                                           FontWeight="{TemplateBinding FontWeight}"
                                           TextWrapping="NoWrap"
                                           Margin="0,-1,0,0" />
                                <Border Grid.Column="4"
                                        Width="10.5"
                                        Height="10.5"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Margin="0">
                                    <Image Source="{x:Static local:IconResources.TwrpDropDownArrowIcon}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Stretch="Uniform" />
                                </Border>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="RootBorder" Property="Opacity" Value="0.98" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="UpdateSystemActionButtonStyle" TargetType="Button">
            <Setter Property="MinWidth" Value="75.25" />
            <Setter Property="Height" Value="24.5" />
            <Setter Property="Padding" Value="10.5,0" />
            <Setter Property="Background" Value="#5C82FD" />
            <Setter Property="BorderBrush" Value="#5C82FD" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3.5">
                            <Grid Margin="{TemplateBinding Padding}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="12.25" />
                                    <ColumnDefinition Width="10.5" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Image Width="12.25"
                                       Height="12.25"
                                       Grid.Column="0"
                                       Margin="0"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Source="{x:Static local:IconResources.MaintenanceUpdateIcon}" />
                                <TextBlock Grid.Column="2"
                                           Margin="0,-1,0,0"
                                           HorizontalAlignment="Left"
                                           VerticalAlignment="Center"
                                           FontSize="10.5"
                                           FontWeight="Medium"
                                           Foreground="{TemplateBinding Foreground}"
                                           Text="{lang:Loc AssemblyName=JiXingFlashTool, Key=Toolbar_UpdateFile}" />
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SidebarButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="38.5" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="#B3333333" />
            <Setter Property="FontSize" Value="12.25" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="10.5,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="RootBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="3.5">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RootBorder" Property="Background" Value="#EEF5FB" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SidebarSelectedButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource SidebarButtonStyle}">
            <Setter Property="Background" Value="{StaticResource SidebarSelectedBackgroundBrush}" />
            <Setter Property="Foreground" Value="{StaticResource SidebarSelectedForegroundBrush}" />
        </Style>

        <Style x:Key="SidebarSmallButtonStyle" TargetType="Button" BasedOn="{StaticResource SidebarButtonStyle}">
            <Setter Property="Height" Value="35" />
            <Setter Property="Padding" Value="10.5,0" />
            <Setter Property="FontSize" Value="12.25" />
        </Style>

        <Style x:Key="SidebarNavButtonStyle"
               TargetType="Button"
