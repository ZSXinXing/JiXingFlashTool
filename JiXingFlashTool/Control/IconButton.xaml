<UserControl x:Class="JiXingFlashTool.Control.IconButton"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="26.5"
             d:DesignWidth="80">
    <Button x:Name="RootButton"
            Padding="0"
            Margin="0"
            BorderThickness="1"
            MinHeight="24.5"
            MinWidth="75.25"
            Background="{Binding ButtonBackground, RelativeSource={RelativeSource AncestorType=UserControl}}"
            BorderBrush="{Binding ButtonBorderBrush, RelativeSource={RelativeSource AncestorType=UserControl}}"
            Command="{Binding ButtonCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
            CommandParameter="{Binding ButtonCommandParameter, RelativeSource={RelativeSource AncestorType=UserControl}}"
            HorizontalContentAlignment="Left"
            VerticalContentAlignment="Stretch">
        <Button.Template>
            <ControlTemplate TargetType="Button">
                <Border Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="3.5">
                    <ContentPresenter HorizontalAlignment="Stretch"
                                      VerticalAlignment="Stretch" />
                </Border>
            </ControlTemplate>
        </Button.Template>
        <Border Padding="10.5,0,10.5,0"
                MinWidth="0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="12.25" />
                    <ColumnDefinition Width="10.5" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Rectangle Grid.Column="0"
                           Width="{Binding ButtonIconSize, RelativeSource={RelativeSource AncestorType=UserControl}}"
                           Height="{Binding ButtonIconSize, RelativeSource={RelativeSource AncestorType=UserControl}}"
                           Fill="{Binding ButtonForeground, RelativeSource={RelativeSource AncestorType=UserControl}}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center">
                    <Rectangle.OpacityMask>
                        <ImageBrush ImageSource="{Binding ButtonIcon, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    Stretch="Uniform" />
                    </Rectangle.OpacityMask>
                </Rectangle>
                <TextBlock Text="{Binding ButtonText, RelativeSource={RelativeSource AncestorType=UserControl}}"
                           Grid.Column="2"
                           MinWidth="0"
                           FontSize="{Binding ButtonFontSize, RelativeSource={RelativeSource AncestorType=UserControl}}"
                           FontWeight="{Binding ButtonFontWeight, RelativeSource={RelativeSource AncestorType=UserControl}}"
                           Foreground="{Binding ButtonForeground, RelativeSource={RelativeSource AncestorType=UserControl}}"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Center"
                           TextAlignment="Left"
                           TextWrapping="NoWrap"
                           Margin="{Binding ButtonTextMargin, RelativeSource={RelativeSource AncestorType=UserControl}}" />
            </Grid>
        </Border>
    </Button>
</UserControl>
