                                        Style="{StaticResource ToolbarOutlineButtonStyle}"
                                        Content="刷新视图" />
                            </StackPanel>
                        </Border>

                    </Grid>
                </Border>
            </Grid>

            <Border Grid.Row="3"
                    Background="White"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,1,0,0">
                <Grid Margin="14,9.75,14,0">
                    <TextBlock Text="{Binding DeviceSummaryText}"
                               FontSize="10.5"
                               Foreground="{StaticResource MutedTextBrush}"
                               VerticalAlignment="Top" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
    </Border>
</Window>

















