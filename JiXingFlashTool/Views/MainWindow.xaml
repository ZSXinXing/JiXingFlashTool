<Window x:Class="JiXingFlashTool.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converter="clr-namespace:JiXingFlashTool.Converters"
        xmlns:viewModel="clr-namespace:JiXingFlashTool.ViewModels"
        Title=""
        Width="1600"
        Height="960"
        MinWidth="1280"
        MinHeight="780"
        Icon="{x:Null}"
        Background="White"
        FontFamily="Microsoft YaHei UI"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded">
    <Window.DataContext>
        <viewModel:MainWindowViewModel />
    </Window.DataContext>

    <Window.Resources>
        <converter:VisibilityBoolConverter x:Key="VisibilityBoolConverter" />
        <converter:InverseVisibilityBoolConverter x:Key="InverseVisibilityBoolConverter" />

        <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#FAFAFA" />
        <SolidColorBrush x:Key="SidebarBorderBrush" Color="#E0E0E0" />
        <SolidColorBrush x:Key="PageBackgroundBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="PagePanelBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="PrimaryBrush" Color="#2196F3" />
        <SolidColorBrush x:Key="PrimarySoftBrush" Color="#E3F2FD" />
        <SolidColorBrush x:Key="WarningBrush" Color="#FF9800" />
        <SolidColorBrush x:Key="DangerBrush" Color="#F44336" />
        <SolidColorBrush x:Key="PurpleBrush" Color="#9C27B0" />
        <SolidColorBrush x:Key="SidebarSelectedBackgroundBrush" Color="#EBF0FF" />
        <SolidColorBrush x:Key="SidebarSelectedForegroundBrush" Color="#5C82FD" />
        <SolidColorBrush x:Key="TextBrush" Color="#333333" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="#999999" />
        <SolidColorBrush x:Key="BorderBrush" Color="#E0E0E0" />
        <SolidColorBrush x:Key="LightInputBrush" Color="#FAFAFA" />

        <Style x:Key="SidebarButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="38.5" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="#B3333333" />
            <Setter Property="FontSize" Value="12.25" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="10.5,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="RootBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="3.5">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RootBorder" Property="Background" Value="#EEF5FB" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SidebarSelectedButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource SidebarButtonStyle}">
            <Setter Property="Background" Value="{StaticResource SidebarSelectedBackgroundBrush}" />
            <Setter Property="Foreground" Value="{StaticResource SidebarSelectedForegroundBrush}" />
        </Style>

        <Style x:Key="SidebarSmallButtonStyle" TargetType="Button" BasedOn="{StaticResource SidebarButtonStyle}">
            <Setter Property="Height" Value="35" />
            <Setter Property="Padding" Value="10.5,0" />
            <Setter Property="FontSize" Value="12.25" />
        </Style>

        <Style x:Key="SidebarIconButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource SidebarButtonStyle}">
            <Setter Property="Width" Value="41" />
            <Setter Property="Height" Value="35" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="RootBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="3.5">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RootBorder" Property="Background" Value="#EEF5FB" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SidebarSelectedIconButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource SidebarIconButtonStyle}">
            <Setter Property="Background" Value="{StaticResource SidebarSelectedBackgroundBrush}" />
            <Setter Property="Foreground" Value="{StaticResource SidebarSelectedForegroundBrush}" />
        </Style>

        <Style x:Key="ToolbarActionButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="26.5" />
            <Setter Property="Margin" Value="0,0,7,0" />
            <Setter Property="Padding" Value="10.5,0" />
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3.5">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ToolbarOutlineButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource ToolbarActionButtonStyle}">
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        </Style>

        <Style x:Key="WarningToolbarButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource ToolbarActionButtonStyle}">
            <Setter Property="Background" Value="{StaticResource WarningBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource WarningBrush}" />
        </Style>

        <Style x:Key="DangerToolbarButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource ToolbarActionButtonStyle}">
            <Setter Property="Background" Value="{StaticResource DangerBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource DangerBrush}" />
        </Style>

        <Style x:Key="PurpleToolbarButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource ToolbarActionButtonStyle}">
            <Setter Property="Background" Value="{StaticResource PurpleBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource PurpleBrush}" />
        </Style>

        <Style x:Key="SearchTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="31.5" />
            <Setter Property="FontSize" Value="12.25" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="{StaticResource LightInputBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="31.5,0,10.5,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="TopSearchTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource SearchTextBoxStyle}">
            <Setter Property="Height" Value="28" />
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="Padding" Value="28,0,10.5,0" />
        </Style>

        <Style x:Key="FilterComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="31.5" />
            <Setter Property="FontSize" Value="12.25" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="{StaticResource LightInputBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10.5,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="HeaderCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Width" Value="13" />
            <Setter Property="Height" Value="13" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="TableCheckBoxStyle" TargetType="CheckBox" BasedOn="{StaticResource HeaderCheckBoxStyle}" />

        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserDeleteRows" Value="False" />
            <Setter Property="CanUserReorderColumns" Value="False" />
            <Setter Property="CanUserResizeColumns" Value="False" />
            <Setter Property="CanUserResizeRows" Value="False" />
            <Setter Property="CanUserSortColumns" Value="False" />
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="SelectionUnit" Value="FullRow" />
            <Setter Property="SelectionMode" Value="Extended" />
            <Setter Property="EnableRowVirtualization" Value="True" />
            <Setter Property="EnableColumnVirtualization" Value="True" />
            <Setter Property="HorizontalGridLinesBrush" Value="#80E0E0E0" />
            <Setter Property="VerticalGridLinesBrush" Value="Transparent" />
            <Setter Property="RowBackground" Value="White" />
            <Setter Property="AlternatingRowBackground" Value="White" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ColumnHeaderStyle">
                <Setter.Value>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Height" Value="43" />
                        <Setter Property="Padding" Value="14,0" />
                        <Setter Property="Background" Value="White" />
                        <Setter Property="Foreground" Value="#CC333333" />
                        <Setter Property="FontSize" Value="10.5" />
                        <Setter Property="FontWeight" Value="Medium" />
                        <Setter Property="BorderBrush" Value="#80E0E0E0" />
                        <Setter Property="BorderThickness" Value="0,0,0,1" />
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="CellStyle">
                <Setter.Value>
                    <Style TargetType="DataGridCell">
                        <Setter Property="Padding" Value="14,0" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="FontSize" Value="12.25" />
                        <Setter Property="Foreground" Value="#E6333333" />
                        <Setter Property="VerticalContentAlignment" Value="Center" />
                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="RowStyle">
                <Setter.Value>
                    <Style TargetType="DataGridRow">
                        <Setter Property="Height" Value="43" />
                        <Setter Property="Background" Value="White" />
                        <Setter Property="BorderBrush" Value="#80E0E0E0" />
                        <Setter Property="BorderThickness" Value="0,0,0,1" />
                        <Setter Property="SnapsToDevicePixels" Value="True" />
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FCFDFF" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#F7FBFF" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource PageBackgroundBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Width="{Binding SidebarPanelWidth}"
                Background="{StaticResource SidebarBackgroundBrush}"
                BorderBrush="{StaticResource SidebarBorderBrush}"
                BorderThickness="0,0,1,0">
            <Grid TextElement.FontFamily="Noto Sans SC"
                  TextOptions.TextFormattingMode="Ideal">
                <Grid.RowDefinitions>
                    <RowDefinition Height="63.563" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="173.5" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        BorderBrush="{StaticResource SidebarBorderBrush}"
                        BorderThickness="0,0,0,1"
                        Padding="14,14,14,15">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="10.5" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

