<Window x:Class="JiXingFlashTool.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converter="clr-namespace:JiXingFlashTool.Converters"
        xmlns:control="clr-namespace:JiXingFlashTool.Control"
        xmlns:local="clr-namespace:JiXingFlashTool.Utils"
        xmlns:viewModel="clr-namespace:JiXingFlashTool.ViewModels"
        Title=""
        Width="1600"
        Height="1066.5"
        MinWidth="1280"
        MinHeight="780"
        Icon="{x:Null}"
        Background="White"
        FontFamily="Microsoft YaHei UI"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded">
    <Window.DataContext>
        <viewModel:MainWindowViewModel />
    </Window.DataContext>

    <Window.Resources>
        <converter:VisibilityBoolConverter x:Key="VisibilityBoolConverter" />
        <converter:InverseVisibilityBoolConverter x:Key="InverseVisibilityBoolConverter" />
        <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#FAFAFA" />
        <SolidColorBrush x:Key="SidebarBorderBrush" Color="#E0E0E0" />
        <SolidColorBrush x:Key="PageBackgroundBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="PagePanelBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="PrimaryBrush" Color="#2196F3" />
        <SolidColorBrush x:Key="PrimarySoftBrush" Color="#E3F2FD" />
        <SolidColorBrush x:Key="WarningBrush" Color="#FF9800" />
        <SolidColorBrush x:Key="DangerBrush" Color="#F44336" />
        <SolidColorBrush x:Key="PurpleBrush" Color="#9C27B0" />
        <SolidColorBrush x:Key="SidebarSelectedBackgroundBrush" Color="#EBF0FF" />
        <SolidColorBrush x:Key="SidebarSelectedForegroundBrush" Color="#5C82FD" />
        <SolidColorBrush x:Key="TextBrush" Color="#333333" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="#999999" />
        <SolidColorBrush x:Key="BorderBrush" Color="#E0E0E0" />
        <SolidColorBrush x:Key="LightInputBrush" Color="#FAFAFA" />

        <Style x:Key="TwrpDropDownMenuItemStyle" TargetType="Button">
            <Setter Property="Height" Value="24.5" />
            <Setter Property="Padding" Value="9,0,10,0" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="RootBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Stretch"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RootBorder" Property="Background" Value="#EEF4FF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="RootBorder" Property="Background" Value="#E4EDFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TwrpDropDownPopupBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#E6E8EF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="6" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="16"
                                      Color="#22000000"
                                      Direction="270"
                                      Opacity="0.18"
                                      ShadowDepth="2" />
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TwrpDropDownToggleButtonStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="75.25" />
            <Setter Property="Height" Value="24.5" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="RootBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3.5"
                                SnapsToDevicePixels="True">
                            <Grid ClipToBounds="True" UseLayoutRounding="True">
                                <Image Width="12.25"
                                       Height="12.25"
                                       Source="{TemplateBinding Tag}"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Top"
                                       Margin="10.5,6.13,0,0" />
                                <TextBlock Text="{TemplateBinding Content}"
                                           HorizontalAlignment="Left"
                                           VerticalAlignment="Top"
                                           TextAlignment="Center"
                                           Foreground="{TemplateBinding Foreground}"
                                           FontSize="{TemplateBinding FontSize}"
                                           FontWeight="{TemplateBinding FontWeight}"
                                           Margin="28.5,4.25,0,0" />
                                <Border Width="10.5"
                                        Height="10.5"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Top"
                                        Margin="54.25,7,0,0">
                                    <Image Source="{x:Static local:IconResources.TwrpDropDownArrowIcon}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Stretch="Uniform" />
                                </Border>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="RootBorder" Property="Opacity" Value="0.98" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SidebarButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="38.5" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="#B3333333" />
            <Setter Property="FontSize" Value="12.25" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="10.5,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="RootBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="3.5">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RootBorder" Property="Background" Value="#EEF5FB" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SidebarSelectedButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource SidebarButtonStyle}">
            <Setter Property="Background" Value="{StaticResource SidebarSelectedBackgroundBrush}" />
            <Setter Property="Foreground" Value="{StaticResource SidebarSelectedForegroundBrush}" />
        </Style>

        <Style x:Key="SidebarSmallButtonStyle" TargetType="Button" BasedOn="{StaticResource SidebarButtonStyle}">
            <Setter Property="Height" Value="35" />
            <Setter Property="Padding" Value="10.5,0" />
            <Setter Property="FontSize" Value="12.25" />
        </Style>

        <Style x:Key="SidebarNavButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource SidebarButtonStyle}">
            <Setter Property="Height" Value="38.5" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="RootBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="3.5">
                            <ContentPresenter Margin="10.5,0" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RootBorder" Property="Background" Value="#F5F8FF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="RootBorder" Property="Background" Value="#E3EBFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SidebarNavIconButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource SidebarButtonStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="RootBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="3.5">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RootBorder" Property="Background" Value="#F5F8FF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="RootBorder" Property="Background" Value="#E3EBFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SidebarIconButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource SidebarButtonStyle}">
            <Setter Property="Width" Value="41" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="RootBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="3.5">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RootBorder" Property="Background" Value="#EEF5FB" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SidebarSelectedIconButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource SidebarIconButtonStyle}">
            <Setter Property="Background" Value="{StaticResource SidebarSelectedBackgroundBrush}" />
            <Setter Property="Foreground" Value="{StaticResource SidebarSelectedForegroundBrush}" />
        </Style>

        <Style x:Key="ToolbarActionButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="26.5" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Padding" Value="10.5,0" />
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3.5">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ToolbarOutlineButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource ToolbarActionButtonStyle}">
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        </Style>

        <Style x:Key="WarningToolbarButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource ToolbarActionButtonStyle}">
            <Setter Property="Background" Value="{StaticResource WarningBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource WarningBrush}" />
        </Style>

        <Style x:Key="DangerToolbarButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource ToolbarActionButtonStyle}">
            <Setter Property="Background" Value="{StaticResource DangerBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource DangerBrush}" />
        </Style>

        <Style x:Key="PurpleToolbarButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource ToolbarActionButtonStyle}">
            <Setter Property="Background" Value="{StaticResource PurpleBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource PurpleBrush}" />
        </Style>

        <Style x:Key="ProfessionalInstructionButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource ToolbarActionButtonStyle}">
            <Setter Property="Height" Value="24.5" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3.5">
                            <ContentPresenter HorizontalAlignment="Stretch"
                                              VerticalAlignment="Stretch" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SearchTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="31.5" />
            <Setter Property="FontSize" Value="12.25" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="{StaticResource LightInputBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="31.5,0,10.5,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="TopSearchTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource SearchTextBoxStyle}">
            <Setter Property="Height" Value="28" />
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="Padding" Value="28,0,10.5,0" />
        </Style>

        <Style x:Key="FilterComboBoxStyle"
               TargetType="ComboBox"
               BasedOn="{StaticResource ComboBoxBaseStyle}">
            <Setter Property="Height" Value="31.5" />
            <Setter Property="FontSize" Value="12.25" />
            <Setter Property="Padding" Value="10.5,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="TableCellTextBlockStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="12.25" />
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style x:Key="HeaderCheckBoxStyle"
               TargetType="CheckBox"
               BasedOn="{StaticResource CheckBoxBaseStyle}">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0" />
        </Style>

        <Style x:Key="TableCheckBoxStyle"
               TargetType="CheckBox"
               BasedOn="{StaticResource HeaderCheckBoxStyle}" />

        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserDeleteRows" Value="False" />
            <Setter Property="CanUserReorderColumns" Value="False" />
            <Setter Property="CanUserResizeColumns" Value="False" />
            <Setter Property="CanUserResizeRows" Value="False" />
            <Setter Property="CanUserSortColumns" Value="False" />
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="SelectionUnit" Value="FullRow" />
            <Setter Property="SelectionMode" Value="Extended" />
            <Setter Property="EnableRowVirtualization" Value="True" />
            <Setter Property="EnableColumnVirtualization" Value="True" />
            <Setter Property="HorizontalGridLinesBrush" Value="#80E0E0E0" />
            <Setter Property="VerticalGridLinesBrush" Value="Transparent" />
            <Setter Property="RowBackground" Value="White" />
            <Setter Property="AlternatingRowBackground" Value="White" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ColumnHeaderStyle">
                <Setter.Value>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Height" Value="43" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Background" Value="#FAFAFA" />
                        <Setter Property="Foreground" Value="#CC333333" />
                        <Setter Property="FontSize" Value="10.5" />
                        <Setter Property="FontWeight" Value="Medium" />
                        <Setter Property="HorizontalContentAlignment" Value="Center" />
                        <Setter Property="VerticalContentAlignment" Value="Center" />
                        <Setter Property="BorderBrush" Value="#80E0E0E0" />
                        <Setter Property="BorderThickness" Value="0,0,0,1" />
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="CellStyle">
                <Setter.Value>
                    <Style TargetType="DataGridCell">
                        <Setter Property="Padding" Value="14,0" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="FontSize" Value="12.25" />
                        <Setter Property="Foreground" Value="#E6333333" />
                        <Setter Property="HorizontalContentAlignment" Value="Center" />
                        <Setter Property="VerticalContentAlignment" Value="Center" />
                        <Setter Property="Background" Value="White" />
                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="White" />
                                <Setter Property="Foreground" Value="#E6333333" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter Property="Background" Value="White" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="RowStyle">
                <Setter.Value>
                    <Style TargetType="DataGridRow">
                        <Setter Property="Height" Value="43" />
                        <Setter Property="Background" Value="White" />
                        <Setter Property="BorderBrush" Value="#80E0E0E0" />
                        <Setter Property="BorderThickness" Value="0,0,0,1" />
                        <Setter Property="SnapsToDevicePixels" Value="True" />
                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="White" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="White" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="{StaticResource PageBackgroundBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="0,1,0,0"
            SnapsToDevicePixels="True"
            TextOptions.TextRenderingMode="Grayscale"
            RenderOptions.ClearTypeHint="Enabled">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Width="{Binding SidebarPanelWidth}"
                    Background="White"
                    BorderBrush="#E6E6E6"
                    BorderThickness="0,0,1,0">
                <Grid TextElement.FontFamily="Microsoft YaHei UI"
                      TextOptions.TextFormattingMode="Ideal">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="{Binding SidebarHeaderHeight}" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="{Binding SidebarFooterHeight}" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            BorderBrush="#E6E6E6"
                            BorderThickness="0,0,0,1">
                        <Grid Margin="7,7,7,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="7" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Viewbox Width="28"
                                     Height="28"
                                     HorizontalAlignment="Left"
                                     VerticalAlignment="Top"
                                     Visibility="{Binding IsSidebarExpanded, Converter={StaticResource VisibilityBoolConverter}}">
                                <Canvas Width="24.5" Height="24.5">
                                    <Path Fill="Transparent" Stroke="#5C82FD" StrokeThickness="2.04167" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="M18.375 4.08333H6.125C4.99742 4.08333 4.08333 4.99742 4.08333 6.125V18.375C4.08333 19.5026 4.99742 20.4167 6.125 20.4167H18.375C19.5026 20.4167 20.4167 19.5026 20.4167 18.375V6.125C20.4167 4.99742 19.5026 4.08333 18.375 4.08333Z" />
                                    <Path Fill="Transparent" Stroke="#5C82FD" StrokeThickness="2.04167" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="M14.2917 9.1875H10.2083C9.64454 9.1875 9.1875 9.64454 9.1875 10.2083V14.2917C9.1875 14.8555 9.64454 15.3125 10.2083 15.3125H14.2917C14.8555 15.3125 15.3125 14.8555 15.3125 14.2917V10.2083C15.3125 9.64454 14.8555 9.1875 14.2917 9.1875Z" />
                                    <Path Fill="Transparent" Stroke="#5C82FD" StrokeThickness="2.04167" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="M15.3125 2.04167V4.08333" />
                                    <Path Fill="Transparent" Stroke="#5C82FD" StrokeThickness="2.04167" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="M15.3125 20.4167V22.4583" />
                                    <Path Fill="Transparent" Stroke="#5C82FD" StrokeThickness="2.04167" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="M2.04167 15.3125H4.08333" />
                                    <Path Fill="Transparent" Stroke="#5C82FD" StrokeThickness="2.04167" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="M2.04167 9.1875H4.08333" />
                                    <Path Fill="Transparent" Stroke="#5C82FD" StrokeThickness="2.04167" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="M20.4167 15.3125H22.4583" />
                                    <Path Fill="Transparent" Stroke="#5C82FD" StrokeThickness="2.04167" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="M20.4167 9.1875H22.4583" />
                                    <Path Fill="Transparent" Stroke="#5C82FD" StrokeThickness="2.04167" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="M9.1875 2.04167V4.08333" />
                                    <Path Fill="Transparent" Stroke="#5C82FD" StrokeThickness="2.04167" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="M9.1875 20.4167V22.4583" />
                                </Canvas>
                            </Viewbox>
                            <Viewbox Width="31.5"
                                     Height="31.5"
                                     HorizontalAlignment="Left"
                                     VerticalAlignment="Top"
                                     Visibility="{Binding IsSidebarExpanded, Converter={StaticResource InverseVisibilityBoolConverter}}">
                                <Canvas Width="28" Height="28">
                                    <Path Fill="Transparent" Stroke="#5C82FD" StrokeThickness="2.33333" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="M21 4.66667H7C5.71134 4.66667 4.66667 5.71134 4.66667 7V21C4.66667 22.2887 5.71134 23.3333 7 23.3333H21C22.2887 23.3333 23.3333 22.2887 23.3333 21V7C23.3333 5.71134 22.2887 4.66667 21 4.66667Z" />
                                    <Path Fill="Transparent" Stroke="#5C82FD" StrokeThickness="2.33333" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="M16.3333 10.5H11.6667C11.0223 10.5 10.5 11.0223 10.5 11.6667V16.3333C10.5 16.9777 11.0223 17.5 11.6667 17.5H16.3333C16.9777 17.5 17.5 16.9777 17.5 16.3333V11.6667C17.5 11.0223 16.9777 10.5 16.3333 10.5Z" />
                                    <Path Fill="Transparent" Stroke="#5C82FD" StrokeThickness="2.33333" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="M17.5 2.33333V4.66667" />
