                                      Stroke="#5C82FD"
                                      StrokeThickness="2.04167"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      Data="M15.3125 2.04167V4.08333" />
                                <Path Fill="Transparent"
                                      Stroke="#5C82FD"
                                      StrokeThickness="2.04167"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      Data="M15.3125 20.4167V22.4583" />
