                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=ListSearchBox2}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
