                                      StrokeLineJoin="Round"
                                      Data="M9.1875 20.4167V22.4583" />
                            </Canvas>
                        </Viewbox>

                        <Viewbox Width="28"
                                 Height="28"
                                 HorizontalAlignment="Left"
                                 VerticalAlignment="Top"
                                 Visibility="{Binding IsSidebarExpanded, Converter={StaticResource InverseVisibilityBoolConverter}}">
                            <Canvas Width="28" Height="28">
                                <Path Fill="Transparent"
                                      Stroke="#5C82FD"
                                      StrokeThickness="2.33333"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
