<Window x:Class="JiXingFlashTool.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converter="clr-namespace:JiXingFlashTool.Converters"
        xmlns:control="clr-namespace:JiXingFlashTool.Control"
        xmlns:lang="clr-namespace:LanguageCore;assembly=LanguageCore"
        xmlns:local="clr-namespace:JiXingFlashTool.Utils"
        xmlns:odin="clr-namespace:JiXingFlashTool.Views.Odin"
        xmlns:viewModel="clr-namespace:JiXingFlashTool.ViewModels"
        Title="{lang:Loc Key=Sidebar_ProductName}"
        Width="1100"
        Height="1000"
        MinWidth="1500"
        MinHeight="780"
        Background="White"
        FontFamily="Microsoft YaHei UI"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded">
    <Window.DataContext>
        <viewModel:MainWindowViewModel />
    </Window.DataContext>

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/Style/MainWindowStyle.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Border Background="{StaticResource PageBackgroundBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="0,1,0,0"
            SnapsToDevicePixels="True"
            TextOptions.TextRenderingMode="Grayscale"
            RenderOptions.ClearTypeHint="Enabled">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Width="{Binding SidebarPanelWidth}"
                    Background="White"
                    BorderBrush="#E6E6E6"
                    BorderThickness="0,0,1,0">
                <Grid TextElement.FontFamily="Microsoft YaHei UI"
                      TextOptions.TextFormattingMode="Ideal">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="{Binding SidebarHeaderHeight}" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="{Binding SidebarFooterHeight}" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            BorderBrush="#E6E6E6"
                            BorderThickness="0,0,0,1">
                        <Grid Margin="7,7,7,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="7" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Image Width="28"
                                   Height="28"
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Top"
                                   Source="/logo.ico"
                                   Stretch="Uniform"
                                   Visibility="{Binding IsSidebarExpanded, Converter={StaticResource VisibilityBoolConverter}}" />
                            <Image Width="31.5"
                                   Height="31.5"
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Top"
                                   Source="/logo.ico"
                                   Stretch="Uniform"
                                   Visibility="{Binding IsSidebarExpanded, Converter={StaticResource InverseVisibilityBoolConverter}}" />
                            <StackPanel Grid.Column="2"
                                        MinWidth="0"
                                        Visibility="{Binding IsSidebarExpanded, Converter={StaticResource VisibilityBoolConverter}}">
                                <TextBlock Text="{lang:Loc Key=Sidebar_ProductName}"
                                           FontSize="15.365"
                                           FontWeight="SemiBold"
                                           Foreground="#333333"
                                           LineHeight="18.438"
                                           TextWrapping="NoWrap" />
                                <TextBlock Margin="0,2,0,0"
                                           Text="{lang:Loc Key=Sidebar_ProductSubtitle}"
                                           FontSize="12.25"
                                           Foreground="#8A333333"
                                           LineHeight="15.313"
                                           TextWrapping="NoWrap" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="1">
                        <StackPanel Margin="7,7,7,0"
                                    Visibility="{Binding IsSidebarExpanded, Converter={StaticResource VisibilityBoolConverter}}">
                            <Button Style="{StaticResource SidebarNavButtonStyle}"
                                    Margin="0,0,0,3.5"
                                    Background="{Binding DeviceManageNavBackground}"
                                    BorderThickness="0"
                                    Command="{Binding ShowDeviceManagePageCommand}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="17.5" />
                                        <ColumnDefinition Width="7" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Viewbox Grid.Column="0" Width="17.5" Height="17.5" VerticalAlignment="Center" HorizontalAlignment="Left">
                                        <Canvas Width="17.5" Height="17.5">
                                            <Path Fill="Transparent" Stroke="{Binding DeviceManageNavForeground}" StrokeThickness="1.45833" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="M12.3958 1.45833H5.10417C4.29875 1.45833 3.64583 2.11125 3.64583 2.91667V14.5833C3.64583 15.3887 4.29875 16.0417 5.10417 16.0417H12.3958C13.2012 16.0417 13.8542 15.3887 13.8542 14.5833V2.91667C13.8542 2.11125 13.2012 1.45833 12.3958 1.45833Z" />
                                            <Path Fill="Transparent" Stroke="{Binding DeviceManageNavForeground}" StrokeThickness="1.45833" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="M8.75 13.125H8.75729" />
                                        </Canvas>
                                    </Viewbox>
                                    <TextBlock Grid.Column="2"
                                               Text="{lang:Loc Key=Sidebar_DeviceManage}"
                                               FontSize="12.25"
                                               FontWeight="Medium"
                                               Foreground="{Binding DeviceManageNavForeground}"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Left" />
                                </Grid>
                            </Button>

                            <Button Style="{StaticResource SidebarNavButtonStyle}"
                                    Margin="0,0,0,3.5"
                                    Background="{Binding OdinNavBackground}"
                                    Command="{Binding ShowOdinFlashPageCommand}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="17.5" />
                                        <ColumnDefinition Width="7" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Viewbox Grid.Column="0" Width="17.5" Height="17.5" VerticalAlignment="Center" HorizontalAlignment="Left">
                                        <Canvas Width="17.5" Height="17.5">
                                            <Path Fill="Transparent" Stroke="{Binding OdinNavForeground}" StrokeThickness="1.45833" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="M9.91667 1.45833L3.64583 9.1875H8.75L7.58333 16.0417L13.8542 7.29167H8.75L9.91667 1.45833Z" />
                                        </Canvas>
                                    </Viewbox>
                                    <TextBlock Grid.Column="2"
                                               Text="Odin"
                                               FontSize="12.25"
                                               FontWeight="Medium"
                                               Foreground="{Binding OdinNavForeground}"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Left" />
                                </Grid>
                            </Button>

                            <Button Style="{StaticResource SidebarNavButtonStyle}"
                                    Margin="0,0,0,3.5"
                                    Background="Transparent"
                                    Command="{Binding ShowResourcePageCommand}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="17.5" />
                                        <ColumnDefinition Width="7" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Viewbox Grid.Column="0" Width="17.5" Height="17.5" VerticalAlignment="Center" HorizontalAlignment="Left">
                                        <Canvas Width="17.5" Height="17.5">
                                            <Path Fill="Transparent" Stroke="#B3333333" StrokeThickness="1.45833" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="M2.91667 5.10417L8.75 1.75L14.5833 5.10417V12.3958L8.75 15.75L2.91667 12.3958V5.10417Z" />
                                            <Path Fill="Transparent" Stroke="#B3333333" StrokeThickness="1.45833" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="M2.91667 5.10417L8.75 8.75L14.5833 5.10417" />
                                            <Path Fill="Transparent" Stroke="#B3333333" StrokeThickness="1.45833" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="M8.75 8.75V15.75" />
                                        </Canvas>
                                    </Viewbox>
                                    <TextBlock Grid.Column="2"
                                               Text="{lang:Loc Key=Sidebar_Resource}"
                                               FontSize="12.25"
                                               FontWeight="Medium"
                                               Foreground="#B3333333"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Left" />
                                </Grid>
                            </Button>

                        </StackPanel>

                        <StackPanel Margin="7,7,7,0"
                                    HorizontalAlignment="Center"
                                    Visibility="{Binding IsSidebarExpanded, Converter={StaticResource InverseVisibilityBoolConverter}}">
                            <Button Style="{StaticResource SidebarNavIconButtonStyle}"
                                    Width="30"
                                    Height="30"
                                    Margin="0,0,0,3.5"
                                    Background="{Binding DeviceManageNavBackground}"
                                    BorderThickness="0"
                                    Command="{Binding ShowDeviceManagePageCommand}">
                                <Viewbox Width="17.5" Height="17.5">
                                    <Canvas Width="17.5" Height="17.5">
                                        <Path Fill="Transparent"
                                              Stroke="{Binding DeviceManageNavForeground}"
                                              StrokeThickness="1.45833"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round"
                                              StrokeLineJoin="Round"
                                              Data="M12.3958 1.45833H5.10417C4.29875 1.45833 3.64583 2.11125 3.64583 2.91667V14.5833C3.64583 15.3887 4.29875 16.0417 5.10417 16.0417H12.3958C13.2012 16.0417 13.8542 15.3887 13.8542 14.5833V2.91667C13.8542 2.11125 13.2012 1.45833 12.3958 1.45833Z" />
                                        <Path Fill="Transparent"
                                              Stroke="{Binding DeviceManageNavForeground}"
                                              StrokeThickness="1.45833"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round"
                                              StrokeLineJoin="Round"
                                              Data="M8.75 13.125H8.75729" />
                                    </Canvas>
                                </Viewbox>
                            </Button>

                                <Button Style="{StaticResource SidebarNavIconButtonStyle}"
                                        Width="30"
                                        Height="30"
                                        Margin="0,0,0,3.5"
                                        Background="{Binding OdinNavBackground}"
                                        Command="{Binding ShowOdinFlashPageCommand}">
                                    <Viewbox Width="17.5" Height="17.5">
                                        <Canvas Width="17.5" Height="17.5">
                                            <Path Fill="Transparent"
                                                  Stroke="{Binding OdinNavForeground}"
                                                  StrokeThickness="1.45833"
                                                  StrokeStartLineCap="Round"
                                                  StrokeEndLineCap="Round"
                                                  StrokeLineJoin="Round"
                                                  Data="M9.91667 1.45833L3.64583 9.1875H8.75L7.58333 16.0417L13.8542 7.29167H8.75L9.91667 1.45833Z" />
                                        </Canvas>
                                    </Viewbox>
                                </Button>

                                <Button Style="{StaticResource SidebarNavIconButtonStyle}"
                                        Width="30"
                                        Height="30"
                                        Margin="0,0,0,3.5"
                                        Background="Transparent"
                                        Command="{Binding ShowResourcePageCommand}">
                                    <Viewbox Width="17.5" Height="17.5">
                                        <Canvas Width="17.5" Height="17.5">
                                            <Path Fill="Transparent"
                                                  Stroke="#B3333333"
                                                  StrokeThickness="1.45833"
                                                  StrokeStartLineCap="Round"
                                                  StrokeEndLineCap="Round"
                                                  StrokeLineJoin="Round"
                                                  Data="M2.91667 5.10417L8.75 1.75L14.5833 5.10417V12.3958L8.75 15.75L2.91667 12.3958V5.10417Z" />
                                            <Path Fill="Transparent"
                                                  Stroke="#B3333333"
                                                  StrokeThickness="1.45833"
                                                  StrokeStartLineCap="Round"
                                                  StrokeEndLineCap="Round"
                                                  StrokeLineJoin="Round"
                                                  Data="M2.91667 5.10417L8.75 8.75L14.5833 5.10417" />
                                            <Path Fill="Transparent"
                                                  Stroke="#B3333333"
                                                  StrokeThickness="1.45833"
                                                  StrokeStartLineCap="Round"
                                                  StrokeEndLineCap="Round"
                                                  StrokeLineJoin="Round"
                                                  Data="M8.75 8.75V15.75" />
                                        </Canvas>
                                    </Viewbox>
                                </Button>

                            </StackPanel>
                    </Grid>

                    <Border Grid.Row="2"
                            BorderBrush="#E6E6E6"
                            BorderThickness="0,1,0,0">
                        <Grid>
                            <StackPanel Margin="7,8,7,0"
                                        Visibility="{Binding IsSidebarExpanded, Converter={StaticResource VisibilityBoolConverter}}">
                                <Button Style="{StaticResource SidebarNavButtonStyle}"
                                        Height="35"
                                        Margin="0,0,0,7"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Command="{Binding ToggleLanguageCommand}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="14" />
                                            <ColumnDefinition Width="7" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Viewbox Grid.Column="0" Width="14" Height="14" HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <Canvas Width="14" Height="14">
                                                <Path Fill="Transparent" Stroke="#333333" Opacity="0.7" StrokeThickness="1.16667" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="M2.91667 4.66667L6.41667 8.16667" />
                                                <Path Fill="Transparent" Stroke="#333333" Opacity="0.7" StrokeThickness="1.16667" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="M2.33333 8.16667L5.83333 4.66667L7 2.91667" />
                                                <Path Fill="Transparent" Stroke="#333333" Opacity="0.7" StrokeThickness="1.16667" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="M8.16667 10.5H11.6667" />
                                            </Canvas>
                                        </Viewbox>
                                        <TextBlock Grid.Column="2"
                                                   Text="{lang:Loc Key=Language_Toggle}"
                                                   FontSize="12.25"
                                                   FontWeight="Medium"
                                                   Foreground="#B3333333"
                                                   VerticalAlignment="Center"
                                                   HorizontalAlignment="Left" />
                                    </Grid>
                                </Button>

                                <Button Style="{StaticResource SidebarNavButtonStyle}"
                                        Height="35"
                                        Margin="0,0,0,7"
                                        Background="#FFF4F4"
                                        BorderThickness="0"
                                        Command="{Binding ProfessionalModeCommand}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="14" />
                                            <ColumnDefinition Width="7" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Viewbox Grid.Column="0" Width="14" Height="14" HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <Canvas Width="14" Height="14">
                                                <Path Fill="Transparent" Stroke="#F44336" StrokeThickness="1.16667" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="M11.6667 7.58333C11.6667 10.5 9.625 11.9583 7.19833 12.8042C7.07126 12.8472 6.93323 12.8452 6.8075 12.7983C4.375 11.9583 2.33333 10.5 2.33333 7.58333V3.5C2.33333 3.34529 2.39479 3.19692 2.50419 3.08752C2.61358 2.97813 2.76196 2.91667 2.91667 2.91667C4.08333 2.91667 5.54167 2.21667 6.55667 1.33C6.68025 1.22442 6.83746 1.1664 7 1.1664C7.16254 1.1664 7.31975 1.22442 7.44333 1.33C8.46417 2.2225 9.91667 2.91667 11.0833 2.91667C11.238 2.91667 11.3864 2.97813 11.4958 3.08752C11.6052 3.19692 11.6667 3.34529 11.6667 3.5V7.58333Z" />
                                            </Canvas>
                                        </Viewbox>
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding MaintainerModeEntryText}"
                                                   FontSize="12.25"
                                                   FontWeight="Medium"
                                                   Foreground="#F44336"
                                                   VerticalAlignment="Center"
                                                   HorizontalAlignment="Left" />
                                    </Grid>
                                </Button>

                                <Border Margin="0,8,0,0"
                                        Padding="10.5,8,10.5,0"
                                        BorderBrush="#E6E6E6"
                                        BorderThickness="0,1,0,0">
                                    <StackPanel>
                                        <TextBlock Text="{Binding AppVersionText}"
                                                   FontSize="10.5"
                                                   Foreground="#99333333" />
                                        <TextBlock Margin="0,3.5,0,0"
                                                   Text="{Binding SidebarDeviceCountText}"
                                                   FontSize="10.5"
                                                   Foreground="#99333333" />
                                    </StackPanel>
                                </Border>

                                <Button Width="209"
                                        Height="28"
                                        Margin="0,0,0,0"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        HorizontalAlignment="Center"
                                        Command="{Binding ToggleSidebarCommand}">
                                    <Grid Width="209" Height="28">
                                        <Viewbox Width="14"
                                                 Height="14"
                                                 HorizontalAlignment="Center"
                                                 VerticalAlignment="Center">
                                            <Canvas Width="14" Height="14">
                                                <Path Fill="Transparent"
                                                      Stroke="#333333"
                                                      Opacity="0.7"
                                                      StrokeThickness="1.16667"
                                                      StrokeStartLineCap="Round"
                                                      StrokeEndLineCap="Round"
                                                      StrokeLineJoin="Round"
                                                      Data="M5.25 10.5L8.75 7L5.25 3.5" />
                                            </Canvas>
                                        </Viewbox>
                                    </Grid>
                                </Button>
                            </StackPanel>

                            <Grid Margin="7,8,7,0"
                                  Visibility="{Binding IsSidebarExpanded, Converter={StaticResource InverseVisibilityBoolConverter}}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="31.5" />
                                    <RowDefinition Height="7" />
                                    <RowDefinition Height="31.5" />
                                    <RowDefinition Height="7" />
                                    <RowDefinition Height="71" />
                                    <RowDefinition Height="7" />
                                    <RowDefinition Height="28" />
                                </Grid.RowDefinitions>

                                <Button Grid.Row="0"
                                        Style="{StaticResource SidebarNavIconButtonStyle}"
                                        Width="30"
                                        Height="31.5"
                                        Background="Transparent"
                                        BorderThickness="0">
                                    <Viewbox Width="14" Height="14">
                                        <Canvas Width="14" Height="14">
                                            <Path Fill="Transparent" Stroke="#333333" Opacity="0.7" StrokeThickness="1.16667" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="M2.91667 4.66667L6.41667 8.16667" />
                                            <Path Fill="Transparent" Stroke="#333333" Opacity="0.7" StrokeThickness="1.16667" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="M2.33333 8.16667L5.83333 4.66667L7 2.91667" />
                                            <Path Fill="Transparent" Stroke="#333333" Opacity="0.7" StrokeThickness="1.16667" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="M1.16667 2.91667H8.16667" />
                                            <Path Fill="Transparent" Stroke="#333333" Opacity="0.7" StrokeThickness="1.16667" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="M4.08333 1.16667H4.66667" />
                                            <Path Fill="Transparent" Stroke="#333333" Opacity="0.7" StrokeThickness="1.16667" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="M12.8333 12.8333L9.91667 7L7 12.8333" />
                                            <Path Fill="Transparent" Stroke="#333333" Opacity="0.7" StrokeThickness="1.16667" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="M8.16667 10.5H11.6667" />
                                        </Canvas>
                                    </Viewbox>
                                </Button>

                                <Button Grid.Row="2"
                                        Style="{StaticResource SidebarNavIconButtonStyle}"
                                        Width="41"
                                        Height="31.5"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Command="{Binding ProfessionalModeCommand}">
                                    <Viewbox Width="14" Height="14">
                                        <Canvas Width="14" Height="14">
                                            <Path Fill="Transparent" Stroke="#333333" Opacity="0.7" StrokeThickness="1.16667" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="M11.6667 7.58333C11.6667 10.5 9.625 11.9583 7.19833 12.8042C7.07126 12.8472 6.93323 12.8452 6.8075 12.7983C4.375 11.9583 2.33333 10.5 2.33333 7.58333V3.5C2.33333 3.34529 2.39479 3.19692 2.50419 3.08752C2.61358 2.97813 2.76196 2.91667 2.91667 2.91667C4.08333 2.91667 5.54167 2.21667 6.55667 1.33C6.68025 1.22442 6.83746 1.1664 7 1.1664C7.16254 1.1664 7.31975 1.22442 7.44333 1.33C8.46417 2.2225 9.91667 2.91667 11.0833 2.91667C11.238 2.91667 11.3864 2.97813 11.4958 3.08752C11.6052 3.19692 11.6667 3.34529 11.6667 3.5V7.58333Z" />
                                        </Canvas>
                                    </Viewbox>
                                </Button>

                                <Border Grid.Row="4"
                                        BorderBrush="#E0E0E0"
                                        BorderThickness="0,1,0,0">
                                    <Grid Margin="0,8,0,0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="28" />
                                            <RowDefinition Height="7" />
                                            <RowDefinition Height="28" />
                                        </Grid.RowDefinitions>

                                        <Button Grid.Row="0"
                                                Style="{StaticResource SidebarNavIconButtonStyle}"
                                        Width="41"
                                        Height="28"
                                        Background="Transparent"
                                        BorderThickness="0">
                                    <Viewbox Width="14" Height="14">
                                        <Canvas Width="14" Height="14">
                                            <Path Fill="Transparent" Stroke="#333333" Opacity="0.7" StrokeThickness="1.16667" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="M7 12.8333C10.2217 12.8333 12.8333 10.2217 12.8333 7C12.8333 3.77834 10.2217 1.16667 7 1.16667C3.77834 1.16667 1.16667 3.77834 1.16667 7C1.16667 10.2217 3.77834 12.8333 7 12.8333Z" />
                                            <Path Fill="Transparent" Stroke="#333333" Opacity="0.7" StrokeThickness="1.16667" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="M7 9.33333V7" />
                                            <Path Fill="Transparent" Stroke="#333333" Opacity="0.7" StrokeThickness="1.16667" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="M7 4.66667H7.00583" />
                                        </Canvas>
                                    </Viewbox>
                                </Button>

                                        <Button Grid.Row="2"
                                                Style="{StaticResource SidebarNavIconButtonStyle}"
                                                Width="30"
                                                Height="28"
                                                Background="Transparent"
                                                BorderThickness="0">
                                            <Viewbox Width="14" Height="14">
                                                <Canvas Width="14" Height="14">
                                                    <Path Fill="Transparent"
                                                          Stroke="#333333"
                                                          Opacity="0.7"
                                                          StrokeThickness="1.16667"
                                                          StrokeStartLineCap="Round"
                                                          StrokeEndLineCap="Round"
                                                          StrokeLineJoin="Round"
                                                          Data="M5.83333 7.58333C6.08385 7.91824 6.40346 8.19536 6.77049 8.39588C7.13752 8.59641 7.54338 8.71565 7.96055 8.74553C8.37771 8.7754 8.79643 8.71521 9.18828 8.56904C9.58014 8.42286 9.93598 8.19412 10.2317 7.89833L11.9817 6.14833C12.513 5.59824 12.8069 4.86149 12.8003 4.09675C12.7937 3.33201 12.4869 2.60047 11.9461 2.0597C11.4054 1.51892 10.6738 1.21218 9.90909 1.20553C9.14435 1.19889 8.40759 1.49287 7.8575 2.02417L6.85417 3.02167" />
                                                    <Path Fill="Transparent"
                                                          Stroke="#333333"
                                                          Opacity="0.7"
                                                          StrokeThickness="1.16667"
                                                          StrokeStartLineCap="Round"
