                                      StrokeThickness="2.33333"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      Data="M10.5 2.33333V4.66667" />
                                <Path Fill="Transparent"
                                      Stroke="#5C82FD"
                                      StrokeThickness="2.33333"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      Data="M10.5 23.3333V25.6667" />
                            </Canvas>
                        </Viewbox>

                        <StackPanel Grid.Column="2"
                                    Width="98"
                                    Visibility="{Binding IsSidebarExpanded, Converter={StaticResource VisibilityBoolConverter}}">
                            <TextBlock Text="极星系统工具"
                                       FontSize="14"
                                       FontWeight="Bold"
                                       LineHeight="17.5"
                                       Foreground="{StaticResource TextBrush}" />
                            <TextBlock Margin="0,2,0,0"
                                       Text="系统更新维护工具"
                                       FontSize="12.25"
                                       LineHeight="15.313"
                                       Foreground="{StaticResource MutedTextBrush}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Grid.Row="1">
                    <StackPanel Margin="7,7,7,0"
                                Visibility="{Binding IsSidebarExpanded, Converter={StaticResource VisibilityBoolConverter}}">
                        <Button Style="{StaticResource SidebarSelectedButtonStyle}"
                                HorizontalAlignment="Stretch"
                                Margin="0,0,0,3.5">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="17.5" />
                                    <ColumnDefinition Width="10.5" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Viewbox Grid.Column="0" Width="17.5" Height="17.5" VerticalAlignment="Center" HorizontalAlignment="Left">
                                    <Canvas Width="17.5" Height="17.5">
                                        <Path Fill="Transparent"
                                              Stroke="#5C82FD"
                                              StrokeThickness="1.45833"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round"
                                              StrokeLineJoin="Round"
                                              Data="M12.3958 1.45833H5.10417C4.29875 1.45833 3.64583 2.11125 3.64583 2.91667V14.5833C3.64583 15.3887 4.29875 16.0417 5.10417 16.0417H12.3958C13.2012 16.0417 13.8542 15.3887 13.8542 14.5833V2.91667C13.8542 2.11125 13.2012 1.45833 12.3958 1.45833Z" />
                                        <Path Fill="Transparent"
                                              Stroke="#5C82FD"
                                              StrokeThickness="1.45833"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round"
                                              StrokeLineJoin="Round"
                                              Data="M8.75 13.125H8.75729" />
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Grid.Column="2"
                                           Width="49"
                                           FontSize="12.25"
                                           FontWeight="Medium"
                                           LineHeight="17.5"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                           Text="设备管理"
                                           TextAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </Button>

                        <Button Style="{StaticResource SidebarButtonStyle}"
                                HorizontalAlignment="Stretch"
                                Margin="0,0,0,3.5"
                                Command="{Binding SingleScreenCommand}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="17.5" />
                                    <ColumnDefinition Width="10.5" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Viewbox Grid.Column="0" Width="17.5" Height="17.5" VerticalAlignment="Center" HorizontalAlignment="Left">
                                    <Canvas Width="17.5" Height="17.5">
                                        <Path Fill="Transparent"
                                              Stroke="#B3333333"
                                              StrokeThickness="1.45833"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round"
                                              StrokeLineJoin="Round"
                                              Data="M14.5833 2.1875H2.91667C2.11125 2.1875 1.45833 2.84042 1.45833 3.64583V10.9375C1.45833 11.7429 2.11125 12.3958 2.91667 12.3958H14.5833C15.3887 12.3958 16.0417 11.7429 16.0417 10.9375V3.64583C16.0417 2.84042 15.3887 2.1875 14.5833 2.1875Z" />
                                        <Path Fill="Transparent"
                                              Stroke="#B3333333"
                                              StrokeThickness="1.45833"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round"
                                              StrokeLineJoin="Round"
                                              Data="M5.83333 15.3125H11.6667" />
                                        <Path Fill="Transparent"
                                              Stroke="#B3333333"
                                              StrokeThickness="1.45833"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round"
                                              StrokeLineJoin="Round"
                                              Data="M8.75 12.3958V15.3125" />
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Grid.Column="2"
                                           Width="24.5"
                                           FontSize="12.25"
                                           FontWeight="Medium"
                                           LineHeight="17.5"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                           Text="投屏"
                                           TextAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </Button>

                        <Button Style="{StaticResource SidebarButtonStyle}"
                                HorizontalAlignment="Stretch"
                                Command="{Binding SyncFileCommand}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="17.5" />
                                    <ColumnDefinition Width="10.5" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Viewbox Grid.Column="0" Width="17.5" Height="17.5" VerticalAlignment="Center" HorizontalAlignment="Left">
                                    <Canvas Width="17.5" Height="17.5">
