                                 Style="{StaticResource SearchTextBoxStyle}"
                                 Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Margin="10.5,0,0,0"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="12"
                                   Foreground="#80333333"
                                   Text="&#xE721;"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False" />
                        <TextBlock Margin="31.5,0,0,0"
                                   FontSize="12.25"
                                   Foreground="#80333333"
                                   Text="搜索设备 (序号/品牌/型号)..."
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=ListSearchBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>

                    <ComboBox Grid.Column="2"
                              Style="{StaticResource FilterComboBoxStyle}"
                              ItemsSource="{Binding ModelFilterList}"
                              SelectedItem="{Binding ModelFilter}" />

                    <ComboBox Grid.Column="4"
                              Style="{StaticResource FilterComboBoxStyle}"
                              ItemsSource="{Binding DeviceStateList}"
                              SelectedItem="{Binding DeviceStateFilter}" />

                    <ComboBox Grid.Column="6"
                              Style="{StaticResource FilterComboBoxStyle}"
                              ItemsSource="{Binding ConnectionTypeList}"
                              SelectedItem="{Binding ConnectionTypeFilter}" />
                </Grid>
            </Border>

            <Grid Grid.Row="2"
                  Background="{StaticResource PageBackgroundBrush}">
                <Border Margin="14,14,14,0"
                        Background="White"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        VerticalAlignment="Top">
                    <Grid>
                        <DataGrid ItemsSource="{Binding DeviceView}"
                                  RowHeaderWidth="0"
                                  Visibility="{Binding ShowDeviceTable, Converter={StaticResource VisibilityBoolConverter}}">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Width="66.5">
                                    <DataGridTemplateColumn.HeaderTemplate>
                                        <DataTemplate>
                                            <CheckBox Style="{StaticResource HeaderCheckBoxStyle}"
                                                      IsChecked="{Binding DataContext.IsSelectAll, RelativeSource={RelativeSource AncestorType=DataGrid}, Mode=TwoWay}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.HeaderTemplate>
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox Style="{StaticResource TableCheckBoxStyle}"
                                                      IsChecked="{Binding IsSelect, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="搴忓彿" Width="96.313">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding DisplayIndex, StringFormat={}{0:00}}"
                                                       FontSize="12.25"
                                                       Foreground="#E6333333"
                                                       VerticalAlignment="Center" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="ADB 搴忓彿" Width="259.313">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Serial}"
                                                       FontFamily="Consolas"
                                                       FontSize="10.5"
                                                       Foreground="#E6333333"
                                                       VerticalAlignment="Center" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTextColumn Header="鍝佺墝"
                                                    Width="159.391"
                                                    Binding="{Binding Brand}" />
                                <DataGridTextColumn Header="鍨嬪彿"
                                                    Width="237.375"
                                                    Binding="{Binding ModelName}" />
                                <DataGridTextColumn Header="安卓版本"
                                                     Width="176.594"
                                                     Binding="{Binding AndroidVersion}" />
                                <DataGridTextColumn Header="系统版本"
                                                     Width="137.594"
                                                     Binding="{Binding SystemVersion}" />

                                <DataGridTemplateColumn Header="连接方式" Width="151.35">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Height="21"
                                                    Padding="8.75,0"
                                                    Background="{Binding ConnectionTagBackground}"
                                                    CornerRadius="1000"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{Binding ConnectionType}"
                                                           Foreground="{Binding ConnectionTagForeground}"
                                                           FontSize="10.5"
                                                           FontWeight="Medium"
                                                           VerticalAlignment="Center" />
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="状态" Width="194.17">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Height="21"
                                                    Padding="8.75,0"
                                                    Background="{Binding DeviceStateTagBackground}"
                                                    CornerRadius="1000"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal"
                                                            VerticalAlignment="Center">
                                                    <Ellipse Width="5.25"
                                                             Height="5.25"
                                                             Margin="0,0,3.5,0"
                                                             Fill="{Binding DeviceStateIndicatorBrush}"
                                                             VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding DeviceState}"
                                                               Foreground="{Binding DeviceStateTagForeground}"
                                                               FontSize="10.5"
                                                               FontWeight="Medium"
                                                               VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="任务消息" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding TaskDetailDisplayMessage}"
                                                       FontSize="10.5"
                                                       Foreground="#CC333333"
                                                       TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <Border Background="White"
                                Visibility="{Binding IsLoading, Converter={StaticResource VisibilityBoolConverter}}">
                            <StackPanel HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                <TextBlock Text="正在初始化设备服务..."
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextBrush}"
                                           HorizontalAlignment="Center" />
                                <TextBlock Margin="0,8,0,0"
                                           Text="请稍候，设备连接信息加载完成后会自动显示。"
                                           FontSize="12.25"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <Border Background="White"
                                Visibility="{Binding HasLoadError, Converter={StaticResource VisibilityBoolConverter}}">
                            <StackPanel HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                <TextBlock Text="设备列表加载失败"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextBrush}"
                                           HorizontalAlignment="Center" />
                                <TextBlock Margin="0,8,0,0"
                                           Text="{Binding LoadErrorMessage}"
                                           FontSize="12.25"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           HorizontalAlignment="Center" />
                                <Button Margin="0,16,0,0"
                                        Command="{Binding RefreshDeviceCommand}"
                                        Style="{StaticResource ToolbarOutlineButtonStyle}"
                                        Content="刷新视图" />
                            </StackPanel>
                        </Border>

                        <Border Background="White"
                                Visibility="{Binding ShowEmptyState, Converter={StaticResource VisibilityBoolConverter}}">
                            <StackPanel HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                <TextBlock Text="暂无检测到设备"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextBrush}"
                                           HorizontalAlignment="Center" />
                                <TextBlock Margin="0,8,0,0"
                                           Text="请连接设备并确认 ADB 已启动，随后点击右上角“刷新设备”。"
                                           FontSize="12.25"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <Border Grid.Row="3"
                    Background="White"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,1,0,0">
                <Grid Margin="14,9.75,14,0">
                    <TextBlock Text="{Binding DeviceSummaryText}"
                               FontSize="10.5"
                               Foreground="{StaticResource MutedTextBrush}"
                               VerticalAlignment="Top" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>



