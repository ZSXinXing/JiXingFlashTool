                                                                    <DataTrigger Binding="{Binding CurrentDeviceState}" Value="Sideload"><Setter Property="Foreground" Value="#E91E63" /></DataTrigger>
                                                                    <DataTrigger Binding="{Binding CurrentDeviceState}" Value="Offline"><Setter Property="Foreground" Value="#F44336" /></DataTrigger>
                                                                    <DataTrigger Binding="{Binding CurrentDeviceState}" Value="Unauthorized"><Setter Property="Foreground" Value="#F44336" /></DataTrigger>
                                                                    <DataTrigger Binding="{Binding CurrentDeviceState}" Value="NoPermissions"><Setter Property="Foreground" Value="#F44336" /></DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="{lang:Loc Key=Table_TaskMessage}" Width="3*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding TaskDetailDisplayMessage}"
                                                       Style="{StaticResource TableCellTextBlockStyle}"
                                                       Foreground="#CC333333" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <Border Background="White"
                                Visibility="{Binding IsLoading, Converter={StaticResource VisibilityBoolConverter}}">
                            <StackPanel HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                <TextBlock Text="{lang:Loc Key=Loading_DeviceServiceTitle}"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextBrush}"
                                           HorizontalAlignment="Center" />
                                <TextBlock Margin="0,8,0,0"
                                           Text="{lang:Loc Key=Loading_DeviceServiceDescription}"
                                           FontSize="12.25"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <Border Background="White"
                                Visibility="{Binding HasLoadError, Converter={StaticResource VisibilityBoolConverter}}">
                            <StackPanel HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                <TextBlock Text="{lang:Loc Key=Error_DeviceListLoadFailed}"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextBrush}"
                                           HorizontalAlignment="Center" />
                                <TextBlock Margin="0,8,0,0"
                                           Text="{Binding LoadErrorMessage}"
                                           FontSize="12.25"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           HorizontalAlignment="Center" />
                                <Button Margin="0,16,0,0"
                                        Command="{Binding RefreshDeviceCommand}"
                                        Style="{StaticResource ToolbarOutlineButtonStyle}"
                                        Content="{lang:Loc Key=Action_RefreshView}" />
                            </StackPanel>
                        </Border>

                    </Grid>
                </Border>
            </Grid>

            <Border Grid.Row="3"
                    Background="White"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,1,0,0">
                <Grid Margin="14,9.75,14,0">
                    <TextBlock Text="{Binding DeviceSummaryText}"
                               FontSize="10.5"
                               Foreground="{StaticResource MutedTextBrush}"
                               VerticalAlignment="Top" />
                </Grid>
            </Border>
        </Grid>
        <odin:OdinFlashView Grid.Column="1"
                            DataContext="{Binding OdinFlashViewModel}"
                            Visibility="{Binding DataContext.IsOdinFlashPage, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource VisibilityBoolConverter}}" />
    </Grid>
</Border>
</Window>

















