<UserControl x:Class="JiXingFlashTool.Views.LoginDialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converter="clr-namespace:JiXingFlashTool.Converters"
             xmlns:lang="clr-namespace:LanguageCore;assembly=LanguageCore"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch"
             MinWidth="0"
             MinHeight="0"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/Style/LoginDialogStyle.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="Transparent">
        <Border Width="336"
                Height="Auto"
                MinHeight="241"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="#FFFFFF"
                BorderBrush="#E0E0E0"
                BorderThickness="1"
                CornerRadius="6"
                SnapsToDevicePixels="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="38.5" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Background="#FFFFFF"
                        BorderBrush="#E0E0E0"
                        BorderThickness="0,0,0,1"
                        Padding="14,0,14,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="21" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <TextBlock Text="&#xE72E;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="14"
                                       Foreground="#5C82FD"
                                       VerticalAlignment="Center" />
                            <TextBlock Margin="7,0,0,0"
                                       Style="{StaticResource LoginDialogTextStyle}"
                                       Text="{lang:Loc Key=Login_Title}"
                                       FontSize="12.25"
                                       FontWeight="Medium"
                                       Foreground="#333333"
                                       VerticalAlignment="Center" />
                        </StackPanel>

                        <Button Grid.Column="1"
                                Style="{StaticResource LoginDialogCloseButtonStyle}"
                                Command="{Binding CancelCommand}">
                            <TextBlock Text="&#xE711;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="12"
                                       Foreground="#999999"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center" />
                        </Button>
                    </Grid>
                </Border>

                <Grid Grid.Row="1"
                      Margin="21,21,21,21">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="50.75" />
                        <RowDefinition Height="14" />
                        <RowDefinition Height="50.75" />
                        <RowDefinition Height="7" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="7" />
                        <RowDefinition Height="33.5" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="14" />
                            <RowDefinition Height="5.25" />
                            <RowDefinition Height="31.5" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0"
                                    Orientation="Horizontal">
                            <TextBlock Text="&#xE77B;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="12.25"
                                       Foreground="#333333"
                                       VerticalAlignment="Center" />
                            <TextBlock Margin="5.25,0,0,0"
                                       Style="{StaticResource LoginDialogTextStyle}"
                                       Text="{lang:Loc Key=Login_UserName}"
                                       FontSize="10.5"
                                       FontWeight="Medium"
                                       Foreground="#333333"
                                       VerticalAlignment="Center" />
                        </StackPanel>

                        <Grid Grid.Row="2">
                            <TextBox x:Name="UserNameTextBox"
                                     Style="{StaticResource LoginDialogInputTextBoxStyle}"
                                     Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="{lang:Loc Key=Login_UserNamePlaceholder}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource LoginDialogPlaceholderTextStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=UserNameTextBox}" Value="">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Grid>

                    <Grid Grid.Row="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="14" />
                            <RowDefinition Height="5.25" />
                            <RowDefinition Height="31.5" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0"
                                    Orientation="Horizontal">
                            <TextBlock Text="&#xE72E;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="12.25"
                                       Foreground="#333333"
                                       VerticalAlignment="Center" />
                            <TextBlock Margin="5.25,0,0,0"
                                       Style="{StaticResource LoginDialogTextStyle}"
                                       Text="{lang:Loc Key=Login_Password}"
                                       FontSize="10.5"
                                       FontWeight="Medium"
                                       Foreground="#333333"
                                       VerticalAlignment="Center" />
                        </StackPanel>

                        <Grid Grid.Row="2">
                            <TextBox x:Name="VisiblePasswordTextBox"
                                     Style="{StaticResource LoginDialogInputTextBoxStyle}"
                                     Padding="10.5,0,31.5,0"
                                     Text="{Binding Password, UpdateSourceTrigger=PropertyChanged}"
                                     Visibility="{Binding IsPasswordVisible, Converter={StaticResource VisibilityBoolConverter}}" />
                            <PasswordBox x:Name="HiddenPasswordBox"
                                         Height="31.5"
                                         Background="#FAFAFA"
                                         BorderBrush="#E0E0E0"
                                         BorderThickness="1"
                                         FontFamily="Noto Sans SC, Microsoft YaHei UI"
                                         FontSize="12.25"
                                         Padding="10.5,0,31.5,0"
                                         VerticalContentAlignment="Center"
                                         PasswordChanged="HiddenPasswordBox_PasswordChanged"
                                         IsVisibleChanged="HiddenPasswordBox_IsVisibleChanged"
                                         Visibility="{Binding IsPasswordVisible, Converter={StaticResource InverseVisibilityBoolConverter}}">
                                <PasswordBox.Template>
                                    <ControlTemplate TargetType="PasswordBox">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="3.5"
                                                SnapsToDevicePixels="True">
                                            <ScrollViewer x:Name="PART_ContentHost"
                                                          Margin="0" />
                                        </Border>
                                    </ControlTemplate>
                                </PasswordBox.Template>
                            </PasswordBox>

                            <TextBlock Margin="10.5,0,31.5,0"
                                       Text="{lang:Loc Key=Login_PasswordPlaceholder}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource LoginDialogPlaceholderTextStyle}">
                                        <Setter Property="Margin" Value="10.5,0,31.5,0" />
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding IsPasswordVisible}" Value="True" />
                                                    <Condition Binding="{Binding Text, ElementName=VisiblePasswordTextBox}" Value="" />
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible" />
                                            </MultiDataTrigger>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding IsPasswordVisible}" Value="False" />
                                                    <Condition Binding="{Binding Password}" Value="" />
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible" />
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <Button Width="21"
                                    Height="21"
                                    Margin="0,0,6,0"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Background="Transparent"
                                    BorderBrush="Transparent"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    Command="{Binding TogglePasswordVisibilityCommand}">
                                <TextBlock Text="&#xE890;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="11"
                                           Foreground="#999999"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Center" />
                            </Button>
                        </Grid>
                    </Grid>

                    <TextBlock Grid.Row="4"
                               Style="{StaticResource LoginDialogTextStyle}"
                               Text="{Binding ErrorMessage}"
                               FontSize="10.5"
                               Foreground="#F44336"
                               Visibility="{Binding HasErrorMessage, Converter={StaticResource VisibilityBoolConverter}}" />

                    <Grid Grid.Row="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="143.5" />
                            <ColumnDefinition Width="7" />
                            <ColumnDefinition Width="141.5" />
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0"
                                Style="{StaticResource LoginDialogOutlineButtonStyle}"
                                Command="{Binding CancelCommand}"
                                Content="{lang:Loc Key=Login_Cancel}" />

                        <Button Grid.Column="2"
                                Style="{StaticResource LoginDialogPrimaryButtonStyle}"
                                Command="{Binding LoginCommand}">
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                <ProgressBar Margin="0,0,5.25,0"
                                             Style="{StaticResource LoginDialogLoadingSpinnerStyle}"
                                             Visibility="{Binding IsLoggingIn, Converter={StaticResource VisibilityBoolConverter}}" />
                                <TextBlock Style="{StaticResource LoginDialogTextStyle}"
                                           Text="{Binding LoginButtonText}"
                                           FontSize="12.25"
                                           FontWeight="Medium"
                                           Foreground="#FFFFFF"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Grid>

                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
