<UserControl x:Class="JiXingFlashTool.Views.CommandListView"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="1024"
             Height="150">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/Style/CommandListStyle.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border Background="White"
            Padding="14,8,14,12"
            CornerRadius="4">
        <StackPanel>
            <StackPanel Orientation="Horizontal"
                        Height="17.5"
                        Margin="0,0,0,7">
                <TextBlock Text="TWRP 娑撴挷绗熼幐鍥︽姢"
                           FontFamily="Microsoft YaHei UI"
                           FontSize="10.5"
                           FontWeight="Medium"
                           Foreground="#F44336"
                           VerticalAlignment="Center" />
                <Border Width="56"
                        Height="17.5"
                        Margin="7,0,0,0"
                        Background="#1AF44336"
                        CornerRadius="3.5">
                    <TextBlock Text="娑撴挷绗熷Ο鈥崇础"
                               Margin="7,0,0,0"
                               FontFamily="Microsoft YaHei UI"
                               FontSize="10.5"
                               FontWeight="Medium"
                               Foreground="#F44336"
                               VerticalAlignment="Center" />
                </Border>
            </StackPanel>

            <StackPanel Orientation="Horizontal">
                <Menu Width="91"
                      Margin="0,0,7,0"
                      Style="{StaticResource TwrpDropDownMenuStyle}">
                    <MenuItem Style="{StaticResource TwrpDropDownItemStyle}">
                        <MenuItem.Header>
                            <Border Width="91"
                                    Height="24.5"
                                    Background="#5C82FD"
                                    CornerRadius="3.5"
                                    SnapsToDevicePixels="True">
                                <Grid Width="91"
                                      Height="24.5">
                                    <Image Width="12.25"
                                           Height="12.25"
                                           Margin="10.5,6.13,0,0"
                                           HorizontalAlignment="Left"
                                           VerticalAlignment="Top"
                                           Source="/Resources/Image/TwrpPro/professional_reboot.png" />
                                    <TextBlock Text="閲嶅惎"
                                               Margin="0,4.25,0,0"
                                               FontSize="10.5"
                                               FontWeight="Medium"
                                               Foreground="White"
                                               TextAlignment="Center"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               TextWrapping="NoWrap" />
                                </Grid>
                            </Border>
                        </MenuItem.Header>
                        <MenuItem.ItemsSource>
                            <Binding Path="RebootCommandCollection" />
                        </MenuItem.ItemsSource>
                        <MenuItem.ItemContainerStyle>
                            <Style TargetType="MenuItem">
                                <Setter Property="Header" Value="{Binding Name}" />
                                <Setter Property="Command" Value="{Binding DataContext.ExecuteCommand, ElementName=Root}" />
                                <Setter Property="CommandParameter" Value="{Binding}" />
                                <Setter Property="MinWidth" Value="112" />
                                <Setter Property="Padding" Value="12,4,12,4" />
                            </Style>
                        </MenuItem.ItemContainerStyle>
                    </MenuItem>
                </Menu>

                <ItemsControl ItemsSource="{Binding CommandCollection}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel IsItemsHost="True"
                                       ItemHeight="24.5" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Width="{Binding ButtonWidth}"
                                    Margin="{Binding ButtonMargin}"
                                    Style="{StaticResource TwrpProButtonStyle}"
                                    Background="{Binding BackgroundBrush}"
                                    BorderBrush="{Binding BackgroundBrush}"
                                    Command="{Binding DataContext.ExecuteCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}">
                                <Grid Width="{Binding ButtonWidth}"
                                      Height="24.5">
                                    <Image Width="12.25"
                                           Height="12.25"
                                           Margin="10.5,6.13,0,0"
                                           HorizontalAlignment="Left"
                                           VerticalAlignment="Top"
                                           Source="{Binding IconSource}" />
                                    <TextBlock Text="{Binding Name}"
                                               Margin="{Binding TextMargin}"
                                               FontSize="10.5"
                                               FontWeight="Medium"
                                               Foreground="White"
                                               TextAlignment="Center"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               TextWrapping="NoWrap" />
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>

