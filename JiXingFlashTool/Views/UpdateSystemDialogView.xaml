<UserControl x:Class="JiXingFlashTool.Views.UpdateSystemDialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:converter="clr-namespace:JiXingFlashTool.Converters"
             xmlns:lang="clr-namespace:LanguageCore;assembly=LanguageCore"
             mc:Ignorable="d"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch"
             MinWidth="0"
             MinHeight="0"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/Style/UpdateSystemDialogStyle.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="Transparent">
        <Border Width="480"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="#FFFFFF"
                BorderBrush="{StaticResource UpdateDialogBorderBrush}"
                BorderThickness="1"
                CornerRadius="6"
                SnapsToDevicePixels="True">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Height" Value="333.5" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding WipeData}" Value="True">
                            <Setter Property="Height" Value="379.5" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="46.5" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="52" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Padding="17.5,12.25,17.5,13.25"
                        BorderBrush="{StaticResource UpdateDialogBorderBrush}"
                        BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="21" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal"
                                    Width="70"
                                    Height="17.5"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center">
                            <Image Width="14"
                                   Height="14"
                                   Source="{StaticResource UpdateDialogTitleIcon}"
                                   Stretch="Uniform" />
                            <TextBlock Margin="7,0,0,0"
                                       Style="{StaticResource UpdateDialogTextBlockStyle}"
                                       Text="{lang:Loc Key=Toolbar_UpdateFile}"
                                       FontSize="12.25"
                                       FontWeight="Medium"
                                       Foreground="{StaticResource UpdateDialogTextBrush}" />
                        </StackPanel>

                        <Button Grid.Column="1"
                                Style="{StaticResource UpdateDialogIconButtonStyle}"
                                Command="{Binding CancelCommand}">
                            <Grid Width="14" Height="14">
                                <Path Data="M10.5 3.5L3.5 10.5"
                                      Stroke="{StaticResource UpdateDialogMutedTextBrush}"
                                      StrokeThickness="1.16667"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round" />
                                <Path Data="M3.5 3.5L10.5 10.5"
                                      Stroke="{StaticResource UpdateDialogMutedTextBrush}"
                                      StrokeThickness="1.16667"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round" />
                            </Grid>
                        </Button>
                    </Grid>
                </Border>

                <Grid Grid.Row="1"
                      Margin="17.5,17.5,17.5,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="16" />
                        <RowDefinition Height="3.25" />
                        <RowDefinition Height="35" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="16" />
                        <RowDefinition Height="3.25" />
                        <RowDefinition Height="35" />
                        <RowDefinition Height="14" />
                        <RowDefinition Height="59.75" />
                        <RowDefinition Height="{Binding WipeData, Converter={StaticResource BooleanToGridLengthConverter}, ConverterParameter=14;0}" />
                        <RowDefinition Height="{Binding WipeData, Converter={StaticResource BooleanToGridLengthConverter}, ConverterParameter=33.5;0}" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               MinHeight="14"
                               HorizontalAlignment="Stretch"
                               Style="{StaticResource UpdateDialogTextBlockStyle}"
                               Text="{lang:Loc Key=UpdateDialog_SelectSystem}"
                               FontSize="10.5"
                               LineHeight="16"
                               FontWeight="Medium"
                               Foreground="{StaticResource UpdateDialogTextBrush}" />

                    <Button Grid.Row="2"
                            Height="35"
                            Width="443"
                            HorizontalAlignment="Stretch"
                            Padding="0"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch"
                            Background="#80F5F5F5"
                            BorderThickness="0"
                            Cursor="Hand"
                            Command="{Binding SelectFileCommand}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Grid HorizontalAlignment="Stretch"
                                      VerticalAlignment="Stretch">
                                    <Border Background="{TemplateBinding Background}"
                                            CornerRadius="3.5" />
                                    <Rectangle Margin="0.5"
                                               RadiusX="3.5"
                                               RadiusY="3.5"
                                               Stroke="{StaticResource UpdateDialogBorderBrush}"
                                               StrokeThickness="1"
                                               StrokeDashArray="2,2"
                                               Fill="Transparent" />
                                    <Grid Margin="11.5,1,11.5,1"
                                          HorizontalAlignment="Stretch"
                                          VerticalAlignment="Stretch">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="14" />
                                            <ColumnDefinition Width="8.75" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <Image Grid.Column="0"
                                               Width="14"
                                               Height="14"
                                               HorizontalAlignment="Left"
                                               VerticalAlignment="Center"
                                               Source="{StaticResource UpdateDialogFileIcon}"
                                               Stretch="Uniform" />
                                        <TextBlock Grid.Column="2"
                                                   Height="14"
                                                   Margin="0,-1,0,0"
                                                   VerticalAlignment="Center"
                                                   Style="{StaticResource UpdateDialogTextBlockStyle}"
                                                   Text="{Binding SelectedFileName}"
                                                   TextTrimming="CharacterEllipsis"
                                                   FontSize="10.5"
                                                   FontWeight="Regular"
                                                   Foreground="{StaticResource UpdateDialogMutedTextBrush}"
                                                   Visibility="{Binding HasSelectedFile, Converter={StaticResource InverseVisibilityBoolConverter}}" />
                                        <Grid Grid.Column="2"
                                              VerticalAlignment="Center"
                                              Visibility="{Binding HasSelectedFile, Converter={StaticResource VisibilityBoolConverter}}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="12.25" />
                                                <ColumnDefinition Width="7" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="7" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Image Grid.Column="0"
                                                   Width="12.25"
                                                   Height="12.25"
                                                   Source="{StaticResource UpdateDialogSelectedFileIcon}"
                                                   Stretch="Uniform" />
                                            <TextBlock Grid.Column="2"
                                                       Height="14"
                                                       Margin="0,-1,0,0"
                                                       VerticalAlignment="Center"
                                                       Style="{StaticResource UpdateDialogTextBlockStyle}"
                                                       Text="{Binding SelectedFileName}"
                                                       TextTrimming="CharacterEllipsis"
                                                       FontSize="10.5"
                                                       FontWeight="Regular"
                                                       Foreground="{StaticResource UpdateDialogTextBrush}" />
                                            <TextBlock Grid.Column="4"
                                                       Height="14"
                                                       Margin="0,-1,0,0"
                                                       VerticalAlignment="Center"
                                                       Style="{StaticResource UpdateDialogTextBlockStyle}"
                                                       Text="{Binding SelectedFileSizeText}"
                                                       FontSize="10.5"
                                                       FontWeight="Regular"
                                                       Foreground="{StaticResource UpdateDialogMutedTextBrush}" />
                                        </Grid>
                                    </Grid>
                                </Grid>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <TextBlock Grid.Row="4"
                               MinHeight="14"
                               HorizontalAlignment="Stretch"
                               Style="{StaticResource UpdateDialogTextBlockStyle}"
                               Text="TWRP"
                               FontSize="10.5"
                               LineHeight="16"
                               FontWeight="Medium"
                               Foreground="{StaticResource UpdateDialogTextBrush}" />

                    <Grid Grid.Row="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="7" />
                            <ColumnDefinition Width="56" />
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0"
                                Height="35"
                                HorizontalAlignment="Stretch"
                                Padding="0"
                                HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Stretch"
                                Background="#80F5F5F5"
                                BorderThickness="0"
                                Cursor="Hand"
                                Command="{Binding SelectTwrpFileCommand}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Grid HorizontalAlignment="Stretch"
                                          VerticalAlignment="Stretch">
                                        <Border Background="{TemplateBinding Background}"
                                                CornerRadius="3.5" />
                                        <Rectangle Margin="0.5"
                                                   RadiusX="3.5"
                                                   RadiusY="3.5"
                                                   Stroke="{StaticResource UpdateDialogBorderBrush}"
                                                   StrokeThickness="1"
                                                   StrokeDashArray="2,2"
                                                   Fill="Transparent" />
                                        <Grid Margin="11.5,1,11.5,1"
                                              HorizontalAlignment="Stretch"
                                              VerticalAlignment="Stretch">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="14" />
                                                <ColumnDefinition Width="8.75" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="7" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <Image Grid.Column="0"
                                                   Width="14"
                                                   Height="14"
                                                   HorizontalAlignment="Left"
                                                   VerticalAlignment="Center"
                                                   Source="{StaticResource UpdateDialogFileIcon}"
                                                   Stretch="Uniform" />
                                            <TextBlock Grid.Column="2"
                                                       Height="14"
                                                       Margin="0,-1,0,0"
                                                       VerticalAlignment="Center"
                                                       Style="{StaticResource UpdateDialogTextBlockStyle}"
                                                       Text="{Binding SelectedTwrpFileName}"
                                                       TextTrimming="CharacterEllipsis"
                                                       FontSize="10.5"
                                                       FontWeight="Regular"
                                                       Foreground="{StaticResource UpdateDialogMutedTextBrush}"
                                                       Visibility="{Binding HasSelectedTwrpFile, Converter={StaticResource InverseVisibilityBoolConverter}}" />
                                            <Grid Grid.Column="2"
                                                  VerticalAlignment="Center"
                                                  Visibility="{Binding HasSelectedTwrpFile, Converter={StaticResource VisibilityBoolConverter}}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="12.25" />
                                                    <ColumnDefinition Width="7" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="7" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Image Grid.Column="0"
                                                       Width="12.25"
                                                       Height="12.25"
                                                       Source="{StaticResource UpdateDialogSelectedFileIcon}"
                                                       Stretch="Uniform" />
                                                <TextBlock Grid.Column="2"
                                                           Height="14"
                                                           Margin="0,-1,0,0"
                                                           VerticalAlignment="Center"
                                                           Style="{StaticResource UpdateDialogTextBlockStyle}"
                                                           Text="{Binding SelectedTwrpFileName}"
                                                           TextTrimming="CharacterEllipsis"
                                                           FontSize="10.5"
                                                           FontWeight="Regular"
                                                           Foreground="{StaticResource UpdateDialogTextBrush}" />
                                                <TextBlock Grid.Column="4"
                                                           Height="14"
                                                           Margin="0,-1,0,0"
                                                           VerticalAlignment="Center"
                                                           Style="{StaticResource UpdateDialogTextBlockStyle}"
                                                           Text="{Binding SelectedTwrpFileSizeText}"
                                                           FontSize="10.5"
                                                           FontWeight="Regular"
                                                           Foreground="{StaticResource UpdateDialogMutedTextBrush}" />
                                            </Grid>
                                        </Grid>
                                    </Grid>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <Button Grid.Column="2"
                                Height="35"
                                Style="{StaticResource UpdateDialogFooterButtonStyle}"
                                Background="#FFFFFF"
                                BorderBrush="{StaticResource UpdateDialogBorderBrush}"
                                BorderThickness="1"
                                Command="{Binding ClearTwrpFileCommand}"
                                Content="{lang:Loc Key=Toolbar_Clear}"
                                Foreground="{StaticResource UpdateDialogTextBrush}"
                                Visibility="{Binding HasSelectedTwrpFile, Converter={StaticResource VisibilityBoolConverter}}" />
                    </Grid>

                    <Border Grid.Row="8"
                            Height="59.75"
                            HorizontalAlignment="Stretch"
                            Padding="11.5,11.5,11.5,1"
                            Background="#4DF5F5F5"
                            BorderBrush="{StaticResource UpdateDialogBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="3.5">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="10.5" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <CheckBox Grid.Column="0"
                                      Style="{StaticResource UpdateDialogDangerCheckBoxStyle}"
                                      Margin="0,1.75,0,0"
                                      VerticalAlignment="Top"
                                      IsChecked="{Binding WipeData}" />

                            <StackPanel Grid.Column="2">
                                <TextBlock Height="14"
                                           Margin="0,4,0,0"
                                           Style="{StaticResource UpdateDialogTextBlockStyle}"
                                           Text="清除数据"
                                           FontSize="10.5"
                                           FontWeight="Medium"
                                           Foreground="{StaticResource UpdateDialogTextBrush}" />
                                <TextBlock Height="14"
                                           Margin="0,4.75,0,0"
                                           Style="{StaticResource UpdateDialogTextBlockStyle}"
                                           Text="刷入前格式化 Data 分区（将清空所有用户数据）"
                                           FontSize="10.5"
                                           FontWeight="Medium"
                                           Foreground="{StaticResource UpdateDialogMutedTextBrush}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Row="10"
                            Height="33.5"
                            HorizontalAlignment="Stretch"
                            Background="#1AF44336"
                            BorderBrush="#4DF44336"
                            BorderThickness="1"
                            CornerRadius="3.5"
                            Visibility="{Binding WipeData, Converter={StaticResource VisibilityBoolConverter}}">
                        <Grid>
                            <Path Width="12.25"
                                  Height="12.25"
                                  Margin="10.5,10.5,0,0"
                                  HorizontalAlignment="Left"
                                  VerticalAlignment="Top"
                                  Data="M6.125 1.53125L11.2292 10.7188H1.02083L6.125 1.53125ZM6.125 4.59375V6.63542M6.125 8.67708H6.1301"
                                  Stroke="{StaticResource UpdateDialogDangerBrush}"
                                  StrokeThickness="1.02"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round" />
                            <TextBlock Height="14"
                                       Margin="29.75,8.75,0,0"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Top"
                                       Style="{StaticResource UpdateDialogTextBlockStyle}"
                                       Text="警告：勾选&quot;清除数据&quot;将在刷入前格式化 Data 分区，所有用户数据将永久删除！"
                                       FontSize="10.5"
                                       FontWeight="Regular"
                                       Foreground="{StaticResource UpdateDialogDangerBrush}" />
                        </Grid>
                    </Border>
                </Grid>

                <Border Grid.Row="2"
                        Padding="17.5,13.25,17.5,12.25"
                        BorderBrush="{StaticResource UpdateDialogBorderBrush}"
                        BorderThickness="0,1,0,0">
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right">
                        <Button Width="51"
                                Margin="0,0,7,0"
                                Style="{StaticResource UpdateDialogFooterButtonStyle}"
                                Background="#FFFFFF"
                                BorderBrush="{StaticResource UpdateDialogBorderBrush}"
                                BorderThickness="1"
                                Command="{Binding CancelCommand}"
                                Content="{lang:Loc Key=Login_Cancel}"
                                Foreground="{StaticResource UpdateDialogTextBrush}" />

                        <Button Width="70"
                                Style="{StaticResource UpdateDialogPrimaryButtonStyle}"
                                Command="{Binding StartTaskCommand}"
                                IsEnabled="{Binding HasSelectedFile}"
                                Content="{lang:Loc Key=UpdateDialog_StartTask}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
