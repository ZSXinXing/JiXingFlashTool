<UserControl x:Class="JiXingFlashTool.Views.UpdateSystemDialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:lang="clr-namespace:LanguageCore;assembly=LanguageCore"
             mc:Ignorable="d"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch"
             MinWidth="0"
             MinHeight="0"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/Style/UpdateSystemDialogStyle.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="Transparent">
        <Border Width="500"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="#FFFFFF"
                BorderBrush="{StaticResource UpdateDialogBorderBrush}"
                BorderThickness="1"
                CornerRadius="6"
                SnapsToDevicePixels="True">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Height" Value="352.75" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding SelectedModeIndex}" Value="1">
                            <Setter Property="Height" Value="482.25" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsFlashFileMode}" Value="True">
                            <Setter Property="Height" Value="222.5" />
                        </DataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsFlashFileMode}" Value="True" />
                                <Condition Binding="{Binding SelectedModeIndex}" Value="1" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Height" Value="421.5" />
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="46.5" />
                    <RowDefinition>
                        <RowDefinition.Style>
                            <Style TargetType="RowDefinition">
                                <Setter Property="Height" Value="193.5" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedModeIndex}" Value="1">
                                        <Setter Property="Height" Value="323" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsFlashFileMode}" Value="True">
                                        <Setter Property="Height" Value="124" />
                                    </DataTrigger>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsFlashFileMode}" Value="True" />
                                            <Condition Binding="{Binding SelectedModeIndex}" Value="1" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Height" Value="323" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </RowDefinition.Style>
                    </RowDefinition>
                    <RowDefinition>
                        <RowDefinition.Style>
                            <Style TargetType="RowDefinition">
                                <Setter Property="Height" Value="58.75" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsFlashFileMode}" Value="True">
                                        <Setter Property="Height" Value="0" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </RowDefinition.Style>
                    </RowDefinition>
                    <RowDefinition Height="52" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Padding="17.5,12.25,17.5,13.25"
                        BorderBrush="{StaticResource UpdateDialogBorderBrush}"
                        BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="21" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center">
                            <Image Width="14"
                                   Height="14"
                                   Source="{StaticResource UpdateDialogTitleIcon}"
                                   Stretch="Uniform" />
                            <TextBlock Margin="7,0,0,0"
                                       Style="{StaticResource UpdateDialogTextBlockStyle}"
                                       Text="{Binding DialogTitleText}"
                                       FontSize="12.25"
                                       FontWeight="Medium"
                                       Foreground="{StaticResource UpdateDialogTextBrush}" />
                        </StackPanel>
                        <Button Grid.Column="1"
                                Style="{StaticResource UpdateDialogIconButtonStyle}"
                                Command="{Binding CancelCommand}">
                            <Grid Width="14" Height="14">
                                <Path Data="M10.5 3.5L3.5 10.5"
                                      Stroke="{StaticResource UpdateDialogMutedTextBrush}"
                                      StrokeThickness="1.16667"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round" />
                                <Path Data="M3.5 3.5L10.5 10.5"
                                      Stroke="{StaticResource UpdateDialogMutedTextBrush}"
                                      StrokeThickness="1.16667"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round" />
                            </Grid>
                        </Button>
                    </Grid>
                </Border>

                <TabControl Grid.Row="1"
                            Style="{StaticResource UpdateDialogTabControlStyle}"
                            SelectedIndex="{Binding SelectedModeIndex}">
                    <TabItem Width="249"
                             Header="{lang:Loc Key=UpdateDialog_ManualTab}"
                             Style="{StaticResource UpdateDialogTabItemStyle}">
                        <Grid Margin="17.5">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="16" />
                                <RowDefinition Height="4" />
                                <RowDefinition Height="35" />
                                <RowDefinition Height="14" />
                                <RowDefinition Height="16" />
                                <RowDefinition Height="4" />
                                <RowDefinition Height="35" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Style="{StaticResource UpdateDialogTextBlockStyle}"
                                       Text="{Binding SelectFileLabel}"
                                       FontSize="10.5"
                                       FontWeight="Medium"
                                       Foreground="{StaticResource UpdateDialogTextBrush}" />
                            <Button Grid.Row="2"
                                    Style="{StaticResource UpdateDialogFileButtonStyle}"
                                    Command="{Binding SelectFileCommand}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="14" />
                                        <ColumnDefinition Width="8.75" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Image Width="14" Height="14" Source="{StaticResource UpdateDialogFileIcon}" />
                                    <TextBlock Grid.Column="2"
                                               Style="{StaticResource UpdateDialogTextBlockStyle}"
                                               Text="{Binding SelectedFileName}"
                                               TextTrimming="CharacterEllipsis"
                                               FontSize="10.5"
                                               Foreground="{StaticResource UpdateDialogTextBrush}" />
                                    <TextBlock Grid.Column="3"
                                               Style="{StaticResource UpdateDialogTextBlockStyle}"
                                               Text="{Binding SelectedFileSizeText}"
                                               FontSize="10.5"
                                               Foreground="{StaticResource UpdateDialogMutedTextBrush}" />
                                </Grid>
                            </Button>
                            <TextBlock Grid.Row="4"
                                       Style="{StaticResource UpdateDialogTextBlockStyle}"
                                       Text="TWRP"
                                       FontSize="10.5"
                                       FontWeight="Medium"
                                       Foreground="{StaticResource UpdateDialogTextBrush}"
                                       Visibility="{Binding IsFlashFileMode, Converter={StaticResource InverseVisibilityBoolConverter}}" />
                            <Grid Grid.Row="6"
                                  Visibility="{Binding IsFlashFileMode, Converter={StaticResource InverseVisibilityBoolConverter}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="7" />
                                    <ColumnDefinition Width="56" />
                                </Grid.ColumnDefinitions>
                                <Button Style="{StaticResource UpdateDialogFileButtonStyle}"
                                        Command="{Binding SelectTwrpFileCommand}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="14" />
                                            <ColumnDefinition Width="8.75" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Image Width="14" Height="14" Source="{StaticResource UpdateDialogFileIcon}" />
                                        <TextBlock Grid.Column="2"
                                                   Style="{StaticResource UpdateDialogTextBlockStyle}"
                                                   Text="{Binding SelectedTwrpFileName}"
                                                   TextTrimming="CharacterEllipsis"
                                                   FontSize="10.5"
                                                   Foreground="{StaticResource UpdateDialogTextBrush}" />
                                        <TextBlock Grid.Column="3"
                                                   Style="{StaticResource UpdateDialogTextBlockStyle}"
                                                   Text="{Binding SelectedTwrpFileSizeText}"
                                                   FontSize="10.5"
                                                   Foreground="{StaticResource UpdateDialogMutedTextBrush}" />
                                    </Grid>
                                </Button>
                                <Button Grid.Column="2"
                                        Style="{StaticResource UpdateDialogFooterButtonStyle}"
                                        Background="#FFFFFF"
                                        BorderBrush="{StaticResource UpdateDialogBorderBrush}"
                                        BorderThickness="1"
                                        Command="{Binding ClearTwrpFileCommand}"
                                        Content="{lang:Loc Key=Toolbar_Clear}"
                                        Foreground="{StaticResource UpdateDialogTextBrush}"
                                        Visibility="{Binding HasSelectedTwrpFile, Converter={StaticResource VisibilityBoolConverter}}" />
                            </Grid>
                        </Grid>
                    </TabItem>

                    <TabItem Width="249"
                             Header="{lang:Loc Key=UpdateDialog_AutomaticTab}"
                             Style="{StaticResource UpdateDialogTabItemStyle}">
                        <Grid Margin="17.5">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="33.5" />
                                <RowDefinition Height="14" />
                                <RowDefinition Height="206" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="226.25" />
                                    <ColumnDefinition Width="10.5" />
                                    <ColumnDefinition Width="226.25" />
                                </Grid.ColumnDefinitions>
                                <Border Background="#4DF5F5F5"
                                        BorderBrush="{StaticResource UpdateDialogBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="3.5">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Grid.ColumnSpan" Value="1" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsFlashFileMode}" Value="True">
                                                    <Setter Property="Grid.ColumnSpan" Value="3" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid Margin="11.5,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="14" />
                                            <ColumnDefinition Width="8.75" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="12.25" />
                                        </Grid.ColumnDefinitions>
                                        <CheckBox VerticalAlignment="Center"
                                                  IsChecked="{Binding IsFlashRomEnabled}"
                                                  Style="{StaticResource UpdateDialogBlueCheckBoxStyle}"
                                                  Visibility="{Binding IsRomLoading, Converter={StaticResource InverseVisibilityBoolConverter}}" />
                                        <Border Width="14"
                                                Height="14"
                                                VerticalAlignment="Center"
                                                Background="#2196F3"
                                                CornerRadius="3.5"
                                                Visibility="{Binding IsRomLoading, Converter={StaticResource VisibilityBoolConverter}}" />
                                        <TextBlock Grid.Column="2"
                                                   VerticalAlignment="Center"
                                                   Style="{StaticResource UpdateDialogTextBlockStyle}"
                                                   Text="{lang:Loc Key=UpdateDialog_FlashRom}"
                                                   FontSize="10.5"
                                                   FontWeight="Medium"
                                                   Foreground="{StaticResource UpdateDialogTextBrush}" />
                                        <ContentControl Grid.Column="3"
                                                        Style="{StaticResource UpdateDialogLoadingIconStyle}"
                                                        Visibility="{Binding IsRomLoading, Converter={StaticResource VisibilityBoolConverter}}" />
                                    </Grid>
                                </Border>
                                <Border Grid.Column="2"
                                        Background="#4DF5F5F5"
                                        BorderBrush="{StaticResource UpdateDialogBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="3.5"
                                        Visibility="{Binding IsFlashFileMode, Converter={StaticResource InverseVisibilityBoolConverter}}">
                                    <Grid Margin="11.5,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="14" />
                                            <ColumnDefinition Width="8.75" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="12.25" />
                                        </Grid.ColumnDefinitions>
                                        <CheckBox VerticalAlignment="Center"
                                                  IsChecked="{Binding IsFlashTwrpEnabled}"
                                                  Style="{StaticResource UpdateDialogOrangeCheckBoxStyle}"
                                                  Visibility="{Binding IsTwrpLoading, Converter={StaticResource InverseVisibilityBoolConverter}}" />
                                        <Border Width="14"
                                                Height="14"
                                                VerticalAlignment="Center"
                                                Background="#FF9800"
                                                CornerRadius="3.5"
                                                Visibility="{Binding IsTwrpLoading, Converter={StaticResource VisibilityBoolConverter}}" />
                                        <TextBlock Grid.Column="2"
                                                   VerticalAlignment="Center"
                                                   Style="{StaticResource UpdateDialogTextBlockStyle}"
                                                   Text="{lang:Loc Key=UpdateDialog_FlashTwrp}"
                                                   FontSize="10.5"
                                                   FontWeight="Medium"
                                                   Foreground="{StaticResource UpdateDialogTextBrush}" />
                                        <ContentControl Grid.Column="3"
                                                        Style="{StaticResource UpdateDialogLoadingIconStyle}"
                                                        Visibility="{Binding IsTwrpLoading, Converter={StaticResource VisibilityBoolConverter}}" />
                                    </Grid>
                                </Border>
                            </Grid>

                            <Border Grid.Row="2"
                                    Background="#33F5F5F5"
                                    CornerRadius="3.5"
                                    SnapsToDevicePixels="True">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="29" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <Border Padding="10.5,7,10.5,8"
                                            BorderBrush="{StaticResource UpdateDialogBorderBrush}"
                                            BorderThickness="0,0,0,1">
                                        <TextBlock Style="{StaticResource UpdateDialogTextBlockStyle}"
                                                   Text="{lang:Loc Key=UpdateDialog_DetectedResources}"
                                                   FontSize="10.5"
                                                   FontWeight="Medium"
                                                   Foreground="{StaticResource UpdateDialogMutedTextBrush}" />
                                    </Border>

                                    <ListBox Grid.Row="1"
                                             ItemsSource="{Binding AutomaticResourceGroups}"
                                             Style="{StaticResource UpdateDialogAutomaticListStyle}"
                                             ItemContainerStyle="{StaticResource UpdateDialogResourceGroupItemStyle}">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Border Height="87"
                                                        Padding="10.5"
                                                        BorderBrush="{StaticResource UpdateDialogBorderBrush}"
                                                        BorderThickness="0,0,0,1">
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="20.5" />
                                                            <RowDefinition Height="22.75" />
                                                            <RowDefinition Height="22.75" />
                                                        </Grid.RowDefinitions>
                                                        <StackPanel Orientation="Horizontal">
                                                            <Border Padding="7,1.75"
                                                                    Background="#1A5C82FD"
                                                                    CornerRadius="3.5">
                                                                <TextBlock Style="{StaticResource UpdateDialogTextBlockStyle}"
                                                                           Text="{Binding SeriesName}"
                                                                           FontSize="11"
                                                                           FontWeight="Bold"
                                                                           Foreground="{StaticResource UpdateDialogPrimaryBrush}" />
                                                            </Border>
                                                            <TextBlock Margin="7,3.25,0,0"
                                                                       Style="{StaticResource UpdateDialogTextBlockStyle}"
                                                                       Text="{Binding DeviceCountText}"
                                                                       FontSize="10.5"
                                                                       Foreground="{StaticResource UpdateDialogMutedTextBrush}" />
                                                        </StackPanel>
                                                        <StackPanel Grid.Row="1"
                                                                    Orientation="Horizontal"
                                                                    VerticalAlignment="Bottom">
                                                            <Border Padding="5.25,1.75"
                                                                    Background="#1A2196F3"
                                                                    CornerRadius="3.5">
                                                                <TextBlock Style="{StaticResource UpdateDialogTextBlockStyle}"
                                                                           Text="ROM"
                                                                           FontSize="10"
                                                                           FontWeight="Bold"
                                                                           Foreground="#2196F3" />
                                                            </Border>
                                                            <TextBlock Margin="5.25,1.75,0,0"
                                                                       MaxWidth="390"
                                                                       Style="{StaticResource UpdateDialogTextBlockStyle}"
                                                                       Text="{Binding RomFileName}"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       FontSize="10.5"
                                                                       Foreground="{StaticResource UpdateDialogTextBrush}"
                                                                       Visibility="{Binding DataContext.IsRomLoading, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource InverseVisibilityBoolConverter}}" />
                                                            <ContentControl Margin="5.25,1.75,0,0"
                                                                            Style="{StaticResource UpdateDialogLoadingIconStyle}"
                                                                            Visibility="{Binding DataContext.IsRomLoading, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource VisibilityBoolConverter}}" />
                                                        </StackPanel>
                                                        <StackPanel Grid.Row="2"
                                                                    Orientation="Horizontal"
                                                                    VerticalAlignment="Bottom"
                                                                    Visibility="{Binding DataContext.IsFlashFileMode, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource InverseVisibilityBoolConverter}}">
                                                            <Border Padding="5.25,1.75"
                                                                    Background="#1AFF9800"
                                                                    CornerRadius="3.5">
                                                                <TextBlock Style="{StaticResource UpdateDialogTextBlockStyle}"
                                                                           Text="TWRP"
                                                                           FontSize="10"
                                                                           FontWeight="Bold"
                                                                           Foreground="#FF9800" />
                                                            </Border>
                                                            <TextBlock Margin="5.25,1.75,0,0"
                                                                       MaxWidth="385"
                                                                       Style="{StaticResource UpdateDialogTextBlockStyle}"
                                                                       Text="{Binding TwrpFileName}"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       FontSize="10.5"
                                                                       Foreground="{StaticResource UpdateDialogTextBrush}"
                                                                       Visibility="{Binding DataContext.IsTwrpLoading, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource InverseVisibilityBoolConverter}}" />
                                                            <ContentControl Margin="5.25,1.75,0,0"
                                                                            Style="{StaticResource UpdateDialogLoadingIconStyle}"
                                                                            Visibility="{Binding DataContext.IsTwrpLoading, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource VisibilityBoolConverter}}" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <Border Grid.RowSpan="2"
                                            Margin="0.5"
                                            BorderBrush="{StaticResource UpdateDialogBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="3.5"
                                            IsHitTestVisible="False"
                                            SnapsToDevicePixels="True" />
                                </Grid>
                            </Border>
                        </Grid>
                    </TabItem>
                </TabControl>

                <Border Grid.Row="2"
                        Padding="17.5,11.5,17.5,10.5"
                        BorderBrush="{StaticResource UpdateDialogBorderBrush}"
                        BorderThickness="0,1,0,0"
                        Visibility="{Binding IsFlashFileMode, Converter={StaticResource InverseVisibilityBoolConverter}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="10.5" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <CheckBox Margin="0,1.75,0,0"
                                  VerticalAlignment="Top"
                                  Style="{StaticResource UpdateDialogDangerCheckBoxStyle}"
                                  IsChecked="{Binding WipeData}" />
                        <StackPanel Grid.Column="2">
                            <TextBlock Margin="0,2,0,0"
                                       Style="{StaticResource UpdateDialogTextBlockStyle}"
                                       Text="{lang:Loc Key=UpdateDialog_WipeData}"
                                       FontSize="10.5"
                                       FontWeight="Medium"
                                       Foreground="{StaticResource UpdateDialogTextBrush}" />
                            <TextBlock Margin="0,7,0,0"
                                       Style="{StaticResource UpdateDialogTextBlockStyle}"
                                       Text="{lang:Loc Key=UpdateDialog_WipeDataDescription}"
                                       FontSize="10.5"
                                       Foreground="{StaticResource UpdateDialogMutedTextBrush}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Row="3"
                        Padding="17.5,13.25,17.5,12.25"
                        BorderBrush="{StaticResource UpdateDialogBorderBrush}"
                        BorderThickness="0,1,0,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Width="51"
                                Margin="0,0,7,0"
                                Style="{StaticResource UpdateDialogFooterButtonStyle}"
                                Background="#FFFFFF"
                                BorderBrush="{StaticResource UpdateDialogBorderBrush}"
                                BorderThickness="1"
                                Command="{Binding CancelCommand}"
                                Content="{lang:Loc Key=Login_Cancel}"
                                Foreground="{StaticResource UpdateDialogTextBrush}" />
                        <Button Width="70"
                                Style="{StaticResource UpdateDialogPrimaryButtonStyle}"
                                Command="{Binding StartTaskCommand}"
                                IsEnabled="{Binding CanStartCurrentMode}"
                                Content="{lang:Loc Key=UpdateDialog_StartTask}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
