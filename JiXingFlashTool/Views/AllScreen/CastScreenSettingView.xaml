<UserControl x:Class="JiXingFlashTool.Views.AllScreen.CastScreenSettingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:JiXingFlashTool.Views.AllScreen" xmlns:hc="https://handyorg.github.io/handycontrol" xmlns:viewModel="clr-namespace:JiXingFlashTool.ViewModels.AllScreen"
             mc:Ignorable="d" 
             Width="400" Height="300"
             
             Loaded="UserControl_Loaded"
             >

    <UserControl.DataContext>
        <viewModel:CastScreenSettingViewModel/>
    </UserControl.DataContext>
    
    <Border CornerRadius="4,4,4,4" Background="#ffffff">
        <DockPanel>
            <Border CornerRadius="4 4 0 0 " Background="#2D77FC" Height="40" DockPanel.Dock="Top">
                <DockPanel >
                    <TextBlock Text="投屏设置" Margin="24 9 0 0 "  FontSize="16" Foreground="#FFFFFF" DockPanel.Dock="Left"/>
                </DockPanel>
            </Border>
            <DockPanel DockPanel.Dock="Bottom" Height="45">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button  Content="取消" Margin="0 0 10 0" Background="#FFFFFF"  Command="hc:ControlCommands.Close"/>
                    <Button  Content="保存" Margin="0 0 10 0" Foreground="#FFFFFF" DockPanel.Dock="Right" Background="#2D77FC" BorderThickness="0"  Command="{Binding SaveCommand}"/>
                </StackPanel>
                <Grid></Grid>
            </DockPanel>
            <Grid Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="40"></RowDefinition>
                    <RowDefinition Height="40"></RowDefinition>
                    <RowDefinition Height="40"></RowDefinition>
                    <RowDefinition Height="40"></RowDefinition>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition></ColumnDefinition>
                    <ColumnDefinition></ColumnDefinition>
                </Grid.ColumnDefinitions>

                <TextBlock Text="小屏分辨率" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" TextAlignment="Left"></TextBlock>
                <ComboBox  Grid.Row="0" Grid.Column="1" Height="30" SelectedIndex="0" Margin="10 0 10 0" ItemsSource="{Binding MiniCastScreenResolutionList}" SelectedItem="{Binding MiniCastScreenResolution}">
                </ComboBox>

                <TextBlock Text="小屏帧率" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" TextAlignment="Left"></TextBlock>
                <ComboBox  Grid.Row="1" Grid.Column="1" Height="30" SelectedIndex="0" Margin="10 0 10 0" ItemsSource="{Binding MiniCastScreenRateList}" SelectedItem="{Binding MiniCastScreenRate }">
                </ComboBox>

                <TextBlock Text="主控分辨率" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" TextAlignment="Left"></TextBlock>
                <ComboBox  Grid.Row="2" Grid.Column="1" Height="30" SelectedIndex="0" Margin="10 0 10 0" ItemsSource="{Binding ControlCastScreenResolutionList}" SelectedItem="{Binding ControlCastScreenResolution}">
                </ComboBox>

                <TextBlock Text="主控帧率" Grid.Row="3" Grid.Column="0" VerticalAlignment="Center" TextAlignment="Left"></TextBlock>
                <ComboBox  Grid.Row="3" Grid.Column="1" Height="30" SelectedIndex="0" Margin="10 0 10 0"  ItemsSource="{Binding ControlCastScreenRateList}" SelectedItem="{Binding ControlCastScreenRate}">
                </ComboBox>
            </Grid>
        </DockPanel>
    </Border>
</UserControl>
