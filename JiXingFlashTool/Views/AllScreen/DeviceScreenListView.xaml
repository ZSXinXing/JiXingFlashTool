<UserControl x:Class="JiXingFlashTool.Views.AllScreen.DeviceScreenListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:JiXingFlashTool.Views.AllScreen" xmlns:viewModel="clr-namespace:JiXingFlashTool.ViewModels.AllScreen" xmlns:Converter="clr-namespace:JiXingFlashTool.Converters"  
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             Background="White"
             Loaded="UserControl_Loaded"
             >
    <UserControl.DataContext>
        <viewModel:DeviceScreenListViewModel/>
    </UserControl.DataContext>
    <UserControl.Resources>
        <Converter:VisibilityBoolConverter x:Key="VisibilityBoolConverter"/>
        <Converter:InverseVisibilityBoolConverter x:Key="InverseVisibilityBoolConverter"/>
        <Converter:ListIndexConverter x:Key="ListIndexConverter"/>
        <Converter:DeviceMiniBorderStyleConverter x:Key="DeviceMiniBorderStyleConverter"/>
        <SolidColorBrush Color="#000000" Opacity="0.4" x:Key="OpacityBrush"/>
        <SolidColorBrush Color="#ffffff" Opacity="0.6" x:Key="InputOpacityBackgroud"/>
    </UserControl.Resources>
    <DockPanel>
        <DockPanel Width="{Binding ControlCastScreenWidth}" Margin="5 5 0 0">
            <DockPanel x:Name="DeviceDPL" DockPanel.Dock="Top"  Width="{Binding ControlCastScreenWidth}" Height="{Binding ControlCastScreenHeight}">
                <Grid DockPanel.Dock="Bottom"   Height="40" VerticalAlignment="Top" Margin="0" Background="#252525"  >
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition></ColumnDefinition>
                        <ColumnDefinition></ColumnDefinition>
                        <ColumnDefinition></ColumnDefinition>
                    </Grid.ColumnDefinitions>
                    <Button  Height="28" Grid.Column="0" Command="{Binding BackCommand}">
                        <Button.Template>
                            <ControlTemplate>
                                <Grid >
                                    <Image  Source="/./Resources/Image/device_bottom_back.png" />
                                </Grid>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button  Width="28" Height="28"  Grid.Column="1" Command="{Binding HomeCommand}">
                        <Button.Template>
                            <ControlTemplate>
                                <Grid >
                                    <Image  Source="/./Resources/Image/device_bottom_home.png" />
                                </Grid>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button  Width="28" Height="28"  Grid.Column="2" Command="{Binding MenuCommand}">
                        <Button.Template>
                            <ControlTemplate>
                                <Grid >
                                    <Image  Source="/./Resources/Image/device_botom_more.png" />
                                </Grid>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
                <DockPanel DockPanel.Dock="Top" Height="30" Background="#252525">
                    <Grid DockPanel.Dock="Right">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition></ColumnDefinition>
                            <ColumnDefinition></ColumnDefinition>
                        </Grid.ColumnDefinitions>
                        <Button  Height="20" Margin="0 0 5 0" Grid.Column="1"  Command="{Binding CloseControlCastScreenCommand}">
                            <Button.Template>
                                <ControlTemplate>
                                    <Grid >
                                        <Image  Source="/./Resources/Image/ic_close.png" />
                                    </Grid>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                    <TextBlock HorizontalAlignment="Center" Margin="10 0 0 0" FontSize="14" Foreground="White" Text="{Binding ControlCastScreen.Index}" Style="{StaticResource TextBlockDefaultBold}"/>
                    <TextBlock HorizontalAlignment="Center" Margin="10 0 0 0" FontSize="14" Foreground="White" Text="{Binding ControlCastScreen.Name}" Style="{StaticResource TextBlockDefaultBold}"/>
                </DockPanel>
                <Image  x:Name="ControlD3dIS" Source="{Binding ControlCastScreen.D3DImageSource}" Stretch="Fill" Margin="0" Focusable="True"
                       PreviewMouseLeftButtonDown="ControlD3dIS_PreviewMouseLeftButtonDown"
                       PreviewMouseMove="ControlD3dIS_PreviewMouseMove"
                       PreviewMouseLeftButtonUp="ControlD3dIS_PreviewMouseLeftButtonUp"
                       PreviewMouseRightButtonDown="ControlD3dIS_PreviewMouseRightButtonDown"
                       PreviewMouseRightButtonUp="ControlD3dIS_PreviewMouseRightButtonUp"
                       PreviewMouseWheel="ControlD3dIS_PreviewMouseWheel"
                       PreviewKeyDown="ControlD3dIS_PreviewKeyDown"
                       PreviewKeyUp="ControlD3dIS_PreviewKeyUp"
                />
            </DockPanel>
            <DockPanel></DockPanel>
        </DockPanel>
        <ListBox x:Name="DeviceListBox" ScrollViewer.HorizontalScrollBarVisibility="Disabled"  ScrollViewer.VerticalScrollBarVisibility="Disabled" ItemsSource="{Binding DeviceCollection}" Margin="5 5 5 0">
            <ListBox.Template>
                <ControlTemplate TargetType="{x:Type ListBox}">
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <WrapPanel Orientation="Horizontal" IsItemsHost="True" ScrollViewer.CanContentScroll="True"/>
                    </ScrollViewer>
                </ControlTemplate>
            </ListBox.Template>
            <ListBox.ItemContainerStyle>
                <Style TargetType="{x:Type ListBoxItem}">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type ListBoxItem}">
                                <Border Name="DeviceBord" Margin="3 3 0 0" BorderThickness="1" Width="{Binding ScreenWidth}" BorderBrush="{Binding IsSelect,Converter={StaticResource DeviceMiniBorderStyleConverter}}">
                                    <Grid>
                                        <DockPanel Margin="0">
                                            <Grid Height="20" DockPanel.Dock="Top">
                                                <DockPanel Background="#252525">
                                                    <TextBlock  DockPanel.Dock="Left" FontSize="9" Text="{Binding Index}" Foreground="#FFFFFF" VerticalAlignment="Center" HorizontalAlignment="Left"  Margin="6 0 5 0"></TextBlock>
                                                    <TextBlock Text="{Binding Name}" FontSize="9" Foreground="#FFFFFF" TextAlignment="Left" VerticalAlignment="Center" HorizontalAlignment="Center"></TextBlock>
                                                </DockPanel>
                                            </Grid>
                                            <Grid Background="Gray" Name="DeviceGrid" Width="{Binding ScreenWidth}"  Height="{Binding ScreenHeight}">
                                                <Image Source="{Binding D3DImageSource}" Stretch="Fill" Margin="0"/>
                                                <Grid.InputBindings>
                                                    <MouseBinding Command="{Binding DataContext.ListBoxDoubleCommand, ElementName=DeviceListBox}" CommandParameter="{Binding SelectedIndex, ElementName=DeviceListBox}" MouseAction="LeftDoubleClick" />
                                                </Grid.InputBindings>
                                            </Grid>
                                        </DockPanel>
                                        <DockPanel Background="#2D77FC" Visibility="{Binding IsControl,Converter={StaticResource VisibilityBoolConverter}}">
                                            <Viewbox Stretch="Uniform">
                                                <Image Width="{Binding  DataContext.InControlWidth,ElementName=DeviceListBox}" Source="/./Resources/Image/inControl.png" />
                                            </Viewbox>
                                        </DockPanel>
                                        
                                    </Grid>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
        </ListBox>
    </DockPanel>
</UserControl>

