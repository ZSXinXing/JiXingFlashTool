<UserControl x:Class="JiXingFlashTool.Views.ResourceManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converter="clr-namespace:JiXingFlashTool.Converters"
             xmlns:lang="clr-namespace:LanguageCore;assembly=LanguageCore"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/Style/ResourceManagementStyle.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="Transparent">
        <Border Width="558"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="White"
                BorderBrush="{StaticResource ResourceBorderBrush}"
                BorderThickness="1"
                CornerRadius="6">
            <Border.Effect>
                <DropShadowEffect BlurRadius="25"
                                  ShadowDepth="0"
                                  Opacity="0.25"
                                  Color="#000000" />
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="45.5" />
                    <RowDefinition Height="41.5" />
                    <RowDefinition Height="194" />
                    <RowDefinition Height="52.5" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        BorderBrush="{StaticResource ResourceBorderBrush}"
                        BorderThickness="0,0,0,1">
                    <Grid Margin="17.5,0">
                        <StackPanel Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <TextBlock Width="14"
                                       Height="14"
                                       Text="&#xE8B7;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="14"
                                       Foreground="#5C82FD"
                                       VerticalAlignment="Center" />
                            <TextBlock Margin="7,0,0,0"
                                       Text="{lang:Loc Key=Resource_Title}"
                                       FontSize="12.25"
                                       FontWeight="Medium"
                                       Foreground="{StaticResource ResourceTextBrush}"
                                       VerticalAlignment="Center" />
                        </StackPanel>

                        <Button Style="{StaticResource ResourceCloseButtonStyle}"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Command="{Binding CloseDialogCommand}">
                            <TextBlock Text="&#xE711;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="12"
                                       Foreground="{StaticResource ResourceMutedTextBrush}" />
                        </Button>
                    </Grid>
                </Border>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0"
                            Style="{StaticResource ResourceTabButtonStyle}"
                            Background="{Binding SystemFirmwareTabBackground}"
                            BorderBrush="{Binding SystemFirmwareTabBorderBrush}"
                            Command="{Binding ShowSystemFirmwareCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8B7;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="14"
                                       Foreground="{Binding SystemFirmwareTabForeground}"
                                       VerticalAlignment="Center" />
                            <TextBlock Margin="7,0,0,0"
                                       Text="{lang:Loc Key=Resource_SystemFirmware}"
                                       FontSize="12.25"
                                       FontWeight="Medium"
                                       Foreground="{Binding SystemFirmwareTabForeground}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Grid.Column="1"
                            Style="{StaticResource ResourceTabButtonStyle}"
                            Background="{Binding TwrpTabBackground}"
                            BorderBrush="{Binding TwrpTabBorderBrush}"
                            Command="{Binding ShowTwrpCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8B7;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="14"
                                       Foreground="{Binding TwrpTabForeground}"
                                       VerticalAlignment="Center" />
                            <TextBlock Margin="7,0,0,0"
                                       Text="TWRP"
                                       FontSize="12.25"
                                       FontWeight="Medium"
                                       Foreground="{Binding TwrpTabForeground}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>

                <ItemsControl Grid.Row="2"
                              Margin="17.5,7,17.5,0"
                              ItemsSource="{Binding ResourceItems}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Width="523"
                                    BorderBrush="{StaticResource ResourceBorderBrush}"
                                    BorderThickness="0,0,0,1">
                                <Grid Height="60">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="56" />
                                        <ColumnDefinition Width="14" />
                                        <ColumnDefinition Width="416.25" />
                                        <ColumnDefinition Width="14" />
                                        <ColumnDefinition Width="22.75" />
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0"
                                            Padding="7,3.5"
                                            Background="{Binding DataContext.SeriesTagBackground, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CornerRadius="3.5"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding SeriesName}"
                                                   FontSize="10.5"
                                                   FontWeight="Bold"
                                                   Foreground="{Binding DataContext.SeriesTagForeground, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
                                    </Border>

                                    <Button Grid.Column="2"
                                            Width="416.25"
                                            Height="31.5"
                                            Padding="0"
                                            HorizontalAlignment="Left"
                                            HorizontalContentAlignment="Stretch"
                                            VerticalContentAlignment="Stretch"
                                            Background="#4DF5F5F5"
                                            BorderThickness="0"
                                            Command="{Binding SelectFileCommand}"
                                            Cursor="Hand">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Grid>
                                                    <Border Background="{TemplateBinding Background}"
                                                            CornerRadius="3.5" />
                                                    <Rectangle RadiusX="3.5"
                                                               RadiusY="3.5"
                                                               Margin="0.5"
                                                               Fill="Transparent"
                                                               Stroke="{StaticResource ResourceBorderBrush}"
                                                               StrokeDashArray="2 2" />
                                                    <Grid Margin="11.5,1,11.5,1">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="12.25" />
                                                            <ColumnDefinition Width="7" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>

                                                        <Image Grid.Column="0"
                                                               Width="12.25"
                                                               Height="12.25"
                                                               HorizontalAlignment="Left"
                                                               VerticalAlignment="Center"
                                                               Source="{StaticResource ResourceFileIcon}"
                                                               Stretch="Uniform" />
                                                        <TextBlock Grid.Column="2"
                                                                   Height="14"
                                                                   Margin="0,-1,0,0"
                                                                   VerticalAlignment="Center"
                                                                   Text="{Binding DisplayFileName}"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   FontSize="10.5"
                                                                   Foreground="{StaticResource ResourceMutedTextBrush}" />
                                                    </Grid>
                                                </Grid>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>

                                    <Button Grid.Column="4"
                                            Width="22.75"
                                            Height="22.75"
                                            Padding="0"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Command="{Binding ClearFileCommand}"
                                            Opacity="0.3">
                                        <TextBlock Text="&#xE711;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="10.5"
                                                   Foreground="{StaticResource ResourceMutedTextBrush}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border Grid.Row="3"
                        BorderBrush="{StaticResource ResourceBorderBrush}"
                        BorderThickness="0,1,0,0">
                    <Grid Margin="17.5,0">
                        <Button Width="103.5"
                                Height="28"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Background="#1A7B9EFF"
                                BorderBrush="#667B9EFF"
                                Foreground="#7B9EFF"
                                Command="{Binding PullFromServerCommand}"
                                Style="{StaticResource ResourcePanelButtonStyle}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE895;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="12.25"
                                           VerticalAlignment="Center" />
                                <TextBlock Margin="5.25,0,0,0"
                                           Text="{lang:Loc Key=Resource_PullFromServer}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center">
                            <Button Width="51"
                                    Background="White"
                                    BorderBrush="{StaticResource ResourceBorderBrush}"
                                    Foreground="{StaticResource ResourceTextBrush}"
                                    Command="{Binding CloseDialogCommand}"
                                    Content="{lang:Loc Key=Action_Close}"
                                    Style="{StaticResource ResourcePanelButtonStyle}" />
                            <Button Width="56"
                                    Margin="7,0,0,0"
                                    Background="#5C82FD"
                                    BorderBrush="#5C82FD"
                                    Foreground="White"
                                    Command="{Binding SaveCommand}"
                                    Content="{lang:Loc Key=Action_Save}"
                                    Style="{StaticResource ResourcePanelButtonStyle}" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
