<UserControl x:Class="JiXingFlashTool.Views.Odin.OdinFirmwareSelectionDialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converter="clr-namespace:JiXingFlashTool.Converters"
             Width="500"
             MaxHeight="650"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/Style/OdinFirmwareSelectionDialogStyle.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border Background="White"
            BorderBrush="{StaticResource DialogBorderBrush}"
            BorderThickness="1"
            CornerRadius="6">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="46.5" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="52" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" BorderBrush="{StaticResource DialogBorderBrush}" BorderThickness="0,0,0,1">
                <Grid Margin="17.5,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="7" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="7" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="21" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="&#xE945;"
                               FontFamily="Segoe MDL2 Assets"
                               Foreground="{StaticResource DialogPrimaryBrush}"
                               FontSize="14"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2"
                               Text="选择固件"
                               FontSize="12.25"
                               FontWeight="Medium"
                               Foreground="#333333"
                               VerticalAlignment="Center" />
                    <Border Grid.Column="4"
                            Height="17.5"
                            Padding="7,0"
                            Background="#1A5C82FD"
                            CornerRadius="3.5"
                            VerticalAlignment="Center">
                        <TextBlock Text="{Binding SelectedDeviceTagText}"
                                   FontSize="10.5"
                                   FontWeight="Medium"
                                   Foreground="{StaticResource DialogPrimaryBrush}"
                                   VerticalAlignment="Center" />
                    </Border>
                    <Button Grid.Column="6"
                            Width="21"
                            Height="21"
                            Style="{StaticResource TransparentIconButtonStyle}"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            Command="{Binding CancelCommand}">
                        <TextBlock Text="&#xE711;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="10"
                                   Foreground="#999999" />
                    </Button>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1"
                          Margin="17.5,17.5,17.5,0"
                          MaxHeight="520"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <StackPanel Margin="0,0,0,10.5">
                    <StackPanel Orientation="Horizontal" Height="18.5">
                        <TextBlock Text="BL" FontSize="10.5" FontWeight="Bold" Foreground="#E91E63" VerticalAlignment="Center" />
                        <TextBlock Margin="7,0,0,0" Text="Bootloader" FontSize="10.5" Foreground="{StaticResource DialogMutedBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                    <Grid Height="35" Margin="0,5.25,0,0">
                        <Button Style="{StaticResource TransparentIconButtonStyle}" Command="{Binding SelectBlCommand}">
                            <Grid>
                                <Rectangle RadiusX="3.5" RadiusY="3.5" Fill="#4DF5F5F5" Stroke="{StaticResource DialogBorderBrush}" StrokeDashArray="2 2" Visibility="{Binding HasBlFile, Converter={StaticResource InverseVisibilityBoolConverter}}" />
                                <Rectangle RadiusX="3.5" RadiusY="3.5" Fill="#1AE91E63" Stroke="#333333" StrokeDashArray="2 2" Visibility="{Binding HasBlFile, Converter={StaticResource VisibilityBoolConverter}}" />
                                <Grid Margin="11.5,0">
                                    <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="12.25" Foreground="#999999" VerticalAlignment="Center" Visibility="{Binding HasBlFile, Converter={StaticResource InverseVisibilityBoolConverter}}" />
                                    <TextBlock Margin="22,0,0,0" Text="点击选择 BL 文件（.tar / .tar.md5）" FontSize="10.5" Foreground="#999999" VerticalAlignment="Center" Visibility="{Binding HasBlFile, Converter={StaticResource InverseVisibilityBoolConverter}}" />
                                    <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="12.25" Foreground="#E91E63" VerticalAlignment="Center" Visibility="{Binding HasBlFile, Converter={StaticResource VisibilityBoolConverter}}" />
                                    <Grid Margin="22,0,54,0" Visibility="{Binding HasBlFile, Converter={StaticResource VisibilityBoolConverter}}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding BlFileName}" FontSize="10.5" Foreground="#333333" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Margin="7,0,0,0" Text="{Binding BlFileSizeText}" FontSize="10.5" Foreground="#999999" VerticalAlignment="Center" />
                                    </Grid>
                                </Grid>
                            </Grid>
                        </Button>
                        <Button Width="15.75" Height="15.75" HorizontalAlignment="Right" Margin="0,0,11.5,0" Style="{StaticResource TransparentIconButtonStyle}" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Command="{Binding ClearBlCommand}" Visibility="{Binding HasBlFile, Converter={StaticResource VisibilityBoolConverter}}">
                            <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="8.5" Foreground="#999999" />
                        </Button>
                    </Grid>
                </StackPanel>

                <StackPanel Margin="0,0,0,10.5">
                    <StackPanel Orientation="Horizontal" Height="18.5">
                        <TextBlock Text="AP" FontSize="10.5" FontWeight="Bold" Foreground="#2196F3" VerticalAlignment="Center" />
                        <TextBlock Margin="7,0,0,0" Text="Android OS 主包" FontSize="10.5" Foreground="{StaticResource DialogMutedBrush}" VerticalAlignment="Center" />
                        <Border Margin="7,0,0,0" Height="18.5" Padding="5.25,0" Background="#1AF44336" CornerRadius="3.5">
                            <TextBlock Text="必选" FontSize="10" FontWeight="Medium" Foreground="#F44336" VerticalAlignment="Center" />
                        </Border>
                    </StackPanel>
                    <Grid Height="35" Margin="0,5.25,0,0">
                        <Button Style="{StaticResource TransparentIconButtonStyle}" Command="{Binding SelectApCommand}">
                            <Grid>
                                <Rectangle RadiusX="3.5" RadiusY="3.5" Fill="#4DF5F5F5" Stroke="{StaticResource DialogBorderBrush}" StrokeDashArray="2 2" Visibility="{Binding HasApFile, Converter={StaticResource InverseVisibilityBoolConverter}}" />
                                <Rectangle RadiusX="3.5" RadiusY="3.5" Fill="#1A2196F3" Stroke="#333333" StrokeDashArray="2 2" Visibility="{Binding HasApFile, Converter={StaticResource VisibilityBoolConverter}}" />
                                <Grid Margin="11.5,0">
                                    <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="12.25" Foreground="#999999" VerticalAlignment="Center" Visibility="{Binding HasApFile, Converter={StaticResource InverseVisibilityBoolConverter}}" />
                                    <TextBlock Margin="22,0,0,0" Text="点击选择 AP 文件（.tar / .tar.md5 / .img）" FontSize="10.5" Foreground="#999999" VerticalAlignment="Center" Visibility="{Binding HasApFile, Converter={StaticResource InverseVisibilityBoolConverter}}" />
                                    <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="12.25" Foreground="#2196F3" VerticalAlignment="Center" Visibility="{Binding HasApFile, Converter={StaticResource VisibilityBoolConverter}}" />
                                    <Grid Margin="22,0,54,0" Visibility="{Binding HasApFile, Converter={StaticResource VisibilityBoolConverter}}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding ApFileName}" FontSize="10.5" Foreground="#333333" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Margin="7,0,0,0" Text="{Binding ApFileSizeText}" FontSize="10.5" Foreground="#999999" VerticalAlignment="Center" />
                                    </Grid>
                                </Grid>
                            </Grid>
                        </Button>
                        <Button Width="15.75" Height="15.75" HorizontalAlignment="Right" Margin="0,0,11.5,0" Style="{StaticResource TransparentIconButtonStyle}" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Command="{Binding ClearApCommand}" Visibility="{Binding HasApFile, Converter={StaticResource VisibilityBoolConverter}}">
                            <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="8.5" Foreground="#999999" />
                        </Button>
                    </Grid>
                </StackPanel>

                <StackPanel Margin="0,0,0,10.5">
                    <StackPanel Orientation="Horizontal" Height="14">
                        <TextBlock Text="CP" FontSize="10.5" FontWeight="Bold" Foreground="#9C27B0" VerticalAlignment="Center" />
                        <TextBlock Margin="7,0,0,0" Text="Modem / Baseband" FontSize="10.5" Foreground="{StaticResource DialogMutedBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                    <Grid Height="35" Margin="0,5.25,0,0">
                        <Button Style="{StaticResource TransparentIconButtonStyle}" Command="{Binding SelectCpCommand}">
                            <Grid>
                                <Rectangle RadiusX="3.5" RadiusY="3.5" Fill="#4DF5F5F5" Stroke="{StaticResource DialogBorderBrush}" StrokeDashArray="2 2" Visibility="{Binding HasCpFile, Converter={StaticResource InverseVisibilityBoolConverter}}" />
                                <Rectangle RadiusX="3.5" RadiusY="3.5" Fill="#1A9C27B0" Stroke="#333333" StrokeDashArray="2 2" Visibility="{Binding HasCpFile, Converter={StaticResource VisibilityBoolConverter}}" />
                                <Grid Margin="11.5,0">
                                    <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="12.25" Foreground="#999999" VerticalAlignment="Center" Visibility="{Binding HasCpFile, Converter={StaticResource InverseVisibilityBoolConverter}}" />
                                    <TextBlock Margin="22,0,0,0" Text="点击选择 CP 文件（.tar / .tar.md5）" FontSize="10.5" Foreground="#999999" VerticalAlignment="Center" Visibility="{Binding HasCpFile, Converter={StaticResource InverseVisibilityBoolConverter}}" />
                                    <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="12.25" Foreground="#9C27B0" VerticalAlignment="Center" Visibility="{Binding HasCpFile, Converter={StaticResource VisibilityBoolConverter}}" />
                                    <Grid Margin="22,0,54,0" Visibility="{Binding HasCpFile, Converter={StaticResource VisibilityBoolConverter}}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding CpFileName}" FontSize="10.5" Foreground="#333333" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Margin="7,0,0,0" Text="{Binding CpFileSizeText}" FontSize="10.5" Foreground="#999999" VerticalAlignment="Center" />
                                    </Grid>
                                </Grid>
                            </Grid>
                        </Button>
                        <Button Width="15.75" Height="15.75" HorizontalAlignment="Right" Margin="0,0,11.5,0" Style="{StaticResource TransparentIconButtonStyle}" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Command="{Binding ClearCpCommand}" Visibility="{Binding HasCpFile, Converter={StaticResource VisibilityBoolConverter}}">
                            <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="8.5" Foreground="#999999" />
                        </Button>
                    </Grid>
                </StackPanel>

                <StackPanel Margin="0,0,0,10.5">
                    <StackPanel Orientation="Horizontal" Height="14">
                        <TextBlock Text="CSC" FontSize="10.5" FontWeight="Bold" Foreground="#4CAF50" VerticalAlignment="Center" />
                        <TextBlock Margin="7,0,0,0" Text="Country Spec" FontSize="10.5" Foreground="{StaticResource DialogMutedBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                    <Grid Height="35" Margin="0,5.25,0,0">
                        <Button Style="{StaticResource TransparentIconButtonStyle}" Command="{Binding SelectCscCommand}">
                            <Grid>
                                <Rectangle RadiusX="3.5" RadiusY="3.5" Fill="#4DF5F5F5" Stroke="{StaticResource DialogBorderBrush}" StrokeDashArray="2 2" Visibility="{Binding HasCscFile, Converter={StaticResource InverseVisibilityBoolConverter}}" />
                                <Rectangle RadiusX="3.5" RadiusY="3.5" Fill="#1A4CAF50" Stroke="#333333" StrokeDashArray="2 2" Visibility="{Binding HasCscFile, Converter={StaticResource VisibilityBoolConverter}}" />
                                <Grid Margin="11.5,0">
                                    <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="12.25" Foreground="#999999" VerticalAlignment="Center" Visibility="{Binding HasCscFile, Converter={StaticResource InverseVisibilityBoolConverter}}" />
                                    <TextBlock Margin="22,0,0,0" Text="点击选择 CSC 文件（.tar / .tar.md5）" FontSize="10.5" Foreground="#999999" VerticalAlignment="Center" Visibility="{Binding HasCscFile, Converter={StaticResource InverseVisibilityBoolConverter}}" />
                                    <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="12.25" Foreground="#4CAF50" VerticalAlignment="Center" Visibility="{Binding HasCscFile, Converter={StaticResource VisibilityBoolConverter}}" />
                                    <Grid Margin="22,0,54,0" Visibility="{Binding HasCscFile, Converter={StaticResource VisibilityBoolConverter}}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding CscFileName}" FontSize="10.5" Foreground="#333333" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Margin="7,0,0,0" Text="{Binding CscFileSizeText}" FontSize="10.5" Foreground="#999999" VerticalAlignment="Center" />
                                    </Grid>
                                </Grid>
                            </Grid>
                        </Button>
                        <Button Width="15.75" Height="15.75" HorizontalAlignment="Right" Margin="0,0,11.5,0" Style="{StaticResource TransparentIconButtonStyle}" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Command="{Binding ClearCscCommand}" Visibility="{Binding HasCscFile, Converter={StaticResource VisibilityBoolConverter}}">
                            <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="8.5" Foreground="#999999" />
                        </Button>
                    </Grid>
                </StackPanel>

                <StackPanel Margin="0,0,0,10.5">
                    <StackPanel Orientation="Horizontal" Height="14">
                        <TextBlock Text="USERDATA" FontSize="10.5" FontWeight="Bold" Foreground="#FF9800" VerticalAlignment="Center" />
                        <TextBlock Margin="7,0,0,0" Text="User Data" FontSize="10.5" Foreground="{StaticResource DialogMutedBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                    <Grid Height="35" Margin="0,5.25,0,0">
                        <Button Style="{StaticResource TransparentIconButtonStyle}" Command="{Binding SelectUserdataCommand}">
                            <Grid>
                                <Rectangle RadiusX="3.5" RadiusY="3.5" Fill="#4DF5F5F5" Stroke="{StaticResource DialogBorderBrush}" StrokeDashArray="2 2" Visibility="{Binding HasUserdataFile, Converter={StaticResource InverseVisibilityBoolConverter}}" />
                                <Rectangle RadiusX="3.5" RadiusY="3.5" Fill="#1AFF9800" Stroke="#333333" StrokeDashArray="2 2" Visibility="{Binding HasUserdataFile, Converter={StaticResource VisibilityBoolConverter}}" />
                                <Grid Margin="11.5,0">
                                    <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="12.25" Foreground="#999999" VerticalAlignment="Center" Visibility="{Binding HasUserdataFile, Converter={StaticResource InverseVisibilityBoolConverter}}" />
                                    <TextBlock Margin="22,0,0,0" Text="点击选择 USERDATA 文件（.tar / .tar.md5）" FontSize="10.5" Foreground="#999999" VerticalAlignment="Center" Visibility="{Binding HasUserdataFile, Converter={StaticResource InverseVisibilityBoolConverter}}" />
                                    <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="12.25" Foreground="#FF9800" VerticalAlignment="Center" Visibility="{Binding HasUserdataFile, Converter={StaticResource VisibilityBoolConverter}}" />
                                    <Grid Margin="22,0,54,0" Visibility="{Binding HasUserdataFile, Converter={StaticResource VisibilityBoolConverter}}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding UserdataFileName}" FontSize="10.5" Foreground="#333333" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Margin="7,0,0,0" Text="{Binding UserdataFileSizeText}" FontSize="10.5" Foreground="#999999" VerticalAlignment="Center" />
                                    </Grid>
                                </Grid>
                            </Grid>
                        </Button>
                        <Button Width="15.75" Height="15.75" HorizontalAlignment="Right" Margin="0,0,11.5,0" Style="{StaticResource TransparentIconButtonStyle}" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Command="{Binding ClearUserdataCommand}" Visibility="{Binding HasUserdataFile, Converter={StaticResource VisibilityBoolConverter}}">
                            <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="8.5" Foreground="#999999" />
                        </Button>
                    </Grid>
                </StackPanel>

                <StackPanel Margin="0,0,0,10.5">
                    <StackPanel Orientation="Horizontal" Height="14">
                        <TextBlock Text="TWRP" FontSize="10.5" FontWeight="Bold" Foreground="#607D8B" VerticalAlignment="Center" />
                        <TextBlock Margin="7,0,0,0" Text=".img 文件，替换 AP 内置 recovery，并自动重启到 recovery" FontSize="10.5" Foreground="{StaticResource DialogMutedBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                    <Grid Height="35" Margin="0,5.25,0,0">
                        <Button Style="{StaticResource TransparentIconButtonStyle}" Command="{Binding SelectTwrpCommand}">
                            <Grid>
                                <Rectangle RadiusX="3.5" RadiusY="3.5" Fill="#4DF5F5F5" Stroke="{StaticResource DialogBorderBrush}" StrokeDashArray="2 2" Visibility="{Binding HasTwrpFile, Converter={StaticResource InverseVisibilityBoolConverter}}" />
                                <Rectangle RadiusX="3.5" RadiusY="3.5" Fill="#1A607D8B" Stroke="#333333" StrokeDashArray="2 2" Visibility="{Binding HasTwrpFile, Converter={StaticResource VisibilityBoolConverter}}" />
                                <Grid Margin="11.5,0">
                                    <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="12.25" Foreground="#999999" VerticalAlignment="Center" Visibility="{Binding HasTwrpFile, Converter={StaticResource InverseVisibilityBoolConverter}}" />
                                    <TextBlock Margin="22,0,0,0" Text="点击选择 TWRP 镜像（.img，替换 AP 内置 recovery，并自动重启到 recovery）" FontSize="10.5" Foreground="#999999" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Visibility="{Binding HasTwrpFile, Converter={StaticResource InverseVisibilityBoolConverter}}" />
                                    <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="12.25" Foreground="#607D8B" VerticalAlignment="Center" Visibility="{Binding HasTwrpFile, Converter={StaticResource VisibilityBoolConverter}}" />
                                    <Grid Margin="22,0,54,0" Visibility="{Binding HasTwrpFile, Converter={StaticResource VisibilityBoolConverter}}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding TwrpFileName}" FontSize="10.5" Foreground="#333333" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Margin="7,0,0,0" Text="{Binding TwrpFileSizeText}" FontSize="10.5" Foreground="#999999" VerticalAlignment="Center" />
                                    </Grid>
                                </Grid>
                            </Grid>
                        </Button>
                        <Button Width="15.75" Height="15.75" HorizontalAlignment="Right" Margin="0,0,11.5,0" Style="{StaticResource TransparentIconButtonStyle}" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Command="{Binding ClearTwrpCommand}" Visibility="{Binding HasTwrpFile, Converter={StaticResource VisibilityBoolConverter}}">
                            <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="8.5" Foreground="#999999" />
                        </Button>
                    </Grid>
                </StackPanel>

                <StackPanel Margin="0,0,0,20"
                            Visibility="{Binding IsSystemPackageSectionVisible, Converter={StaticResource VisibilityBoolConverter}}">
                    <StackPanel Orientation="Horizontal" Height="14">
                        <TextBlock Text="系统包" FontSize="10.5" FontWeight="Bold" Foreground="#009688" VerticalAlignment="Center" />
                        <TextBlock Margin="7,0,0,0" Text=".zip / .ps，TWRP 侧载刷入 LineageOS 后自动重启系统" FontSize="10.5" Foreground="{StaticResource DialogMutedBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                    <Grid Height="35" Margin="0,5.25,0,0">
                        <Button Style="{StaticResource TransparentIconButtonStyle}" Command="{Binding SelectSystemPackageCommand}">
                            <Grid>
                                <Rectangle RadiusX="3.5" RadiusY="3.5" Fill="#4DF5F5F5" Stroke="{StaticResource DialogBorderBrush}" StrokeDashArray="2 2" Visibility="{Binding HasSystemPackageFile, Converter={StaticResource InverseVisibilityBoolConverter}}" />
                                <Rectangle RadiusX="3.5" RadiusY="3.5" Fill="#1A009688" Stroke="#333333" StrokeDashArray="2 2" Visibility="{Binding HasSystemPackageFile, Converter={StaticResource VisibilityBoolConverter}}" />
                                <Grid Margin="11.5,0">
                                    <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="12.25" Foreground="#999999" VerticalAlignment="Center" Visibility="{Binding HasSystemPackageFile, Converter={StaticResource InverseVisibilityBoolConverter}}" />
                                    <TextBlock Margin="22,0,0,0" Text="点击选择系统包（.zip / .ps，TWRP 侧载刷入）" FontSize="10.5" Foreground="#999999" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Visibility="{Binding HasSystemPackageFile, Converter={StaticResource InverseVisibilityBoolConverter}}" />
                                    <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="12.25" Foreground="#009688" VerticalAlignment="Center" Visibility="{Binding HasSystemPackageFile, Converter={StaticResource VisibilityBoolConverter}}" />
                                    <Grid Margin="22,0,54,0" Visibility="{Binding HasSystemPackageFile, Converter={StaticResource VisibilityBoolConverter}}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding SystemPackageFileName}" FontSize="10.5" Foreground="#333333" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Margin="7,0,0,0" Text="{Binding SystemPackageFileSizeText}" FontSize="10.5" Foreground="#999999" VerticalAlignment="Center" />
                                    </Grid>
                                </Grid>
                            </Grid>
                        </Button>
                        <Button Width="15.75" Height="15.75" HorizontalAlignment="Right" Margin="0,0,11.5,0" Style="{StaticResource TransparentIconButtonStyle}" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Command="{Binding ClearSystemPackageCommand}" Visibility="{Binding HasSystemPackageFile, Converter={StaticResource VisibilityBoolConverter}}">
                            <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="8.5" Foreground="#999999" />
                        </Button>
                    </Grid>

                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <CheckBox Content="双清" FontSize="10.5" Foreground="#333333" IsChecked="{Binding WipeDataBeforeSystemFlash}" />
                        <CheckBox Margin="16,0,0,0" Content="清除系统" FontSize="10.5" Foreground="#333333" IsChecked="{Binding WipeSystemBeforeSystemFlash}" />
                        <CheckBox Margin="16,0,0,0" Content="格式化" FontSize="10.5" Foreground="#333333" IsChecked="{Binding FormatDataBeforeSystemFlash}" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2" BorderBrush="{StaticResource DialogBorderBrush}" BorderThickness="0,1,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,13.25,17.5,0">
                    <Button Width="51"
                            Style="{StaticResource DialogFooterButtonStyle}"
                            Background="White"
                            BorderBrush="{StaticResource DialogBorderBrush}"
                            BorderThickness="1"
                            Foreground="#333333"
                            Command="{Binding CancelCommand}"
                            Content="取消" />
                    <Button Width="98"
                            Margin="7,0,0,0"
                            Style="{StaticResource DialogFooterButtonStyle}"
                            Background="{StaticResource DialogPrimaryBrush}"
                            BorderThickness="0"
                            Foreground="White"
                            Command="{Binding ConfirmCommand}"
                            Content="刷入" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>
