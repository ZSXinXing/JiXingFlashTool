<UserControl x:Class="JiXingFlashTool.Views.Odin.OdinFlashView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converter="clr-namespace:JiXingFlashTool.Converters"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             Background="#F5F5F5">
    <UserControl.Resources>
        <converter:VisibilityBoolConverter x:Key="VisibilityBoolConverter" />
        <SolidColorBrush x:Key="OdinBorderBrush" Color="#E0E0E0" />
        <SolidColorBrush x:Key="OdinMutedBrush" Color="#999999" />

        <Style x:Key="OdinCellTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.25" />
            <Setter Property="Foreground" Value="#E6333333" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="TextWrapping" Value="NoWrap" />
        </Style>

        <Style x:Key="OdinMutedCellTextStyle" TargetType="TextBlock" BasedOn="{StaticResource OdinCellTextStyle}">
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="Foreground" Value="#999999" />
        </Style>

        <Style x:Key="OdinHeaderCheckBoxStyle"
               TargetType="CheckBox"
               BasedOn="{StaticResource CheckBoxBaseStyle}">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0" />
        </Style>

        <Style x:Key="OdinTableCheckBoxStyle"
               TargetType="CheckBox"
               BasedOn="{StaticResource OdinHeaderCheckBoxStyle}" />

        <Style x:Key="OdinToolbarButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="31.5" />
            <Setter Property="Padding" Value="10.5,0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3.5"
                                Opacity="1">
                            <Grid Margin="{TemplateBinding Padding}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="12.25" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="{TemplateBinding Tag}"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="12.25"
                                           Foreground="{TemplateBinding Foreground}"
                                           VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2"
                                           Text="{TemplateBinding Content}"
                                           Foreground="{TemplateBinding Foreground}"
                                           FontSize="{TemplateBinding FontSize}"
                                           FontWeight="{TemplateBinding FontWeight}"
                                           VerticalAlignment="Center"
                                           TextAlignment="Center"
                                           TextTrimming="None" />
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#F5F5F5" />
                    <Setter Property="BorderBrush" Value="#E0E0E0" />
                    <Setter Property="Foreground" Value="#999999" />
                    <Setter Property="Cursor" Value="Arrow" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="OdinSelectFirmwareButtonStyle" TargetType="Button" BasedOn="{StaticResource OdinToolbarButtonStyle}">
            <Setter Property="Width" Value="122.5" />
            <Setter Property="Background" Value="#1A5C82FD" />
            <Setter Property="BorderBrush" Value="#665C82FD" />
            <Setter Property="Foreground" Value="#5C82FD" />
            <Setter Property="Tag" Value="&#xE8E5;" />
        </Style>

        <Style x:Key="OdinStopButtonStyle" TargetType="Button" BasedOn="{StaticResource OdinToolbarButtonStyle}">
            <Setter Property="Width" Value="101.5" />
            <Setter Property="Background" Value="#1AF44336" />
            <Setter Property="BorderBrush" Value="#66F44336" />
            <Setter Property="Foreground" Value="#F44336" />
            <Setter Property="Tag" Value="&#xE71A;" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="53.5" />
            <RowDefinition Height="29" />
            <RowDefinition Height="*" />
            <RowDefinition Height="32.5" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource OdinBorderBrush}" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" Margin="14,10.5" VerticalAlignment="Top">
                <Button Style="{StaticResource OdinSelectFirmwareButtonStyle}"
                        Command="{Binding OpenFirmwareDialogCommand}"
                        Content="{Binding SelectFirmwareButtonText}" />
                <Button Margin="7,0,0,0"
                        Style="{StaticResource OdinStopButtonStyle}"
                        Command="{Binding StopSelectedDevicesCommand}"
                        Content="{Binding StopButtonText}" />
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Background="#0DFF9800" BorderBrush="{StaticResource OdinBorderBrush}" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" Margin="14,0" VerticalAlignment="Center">
                <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="12.25" Foreground="#FF9800" VerticalAlignment="Center" />
                <TextBlock Margin="7,0,0,0" FontSize="10.5" Foreground="#999999" VerticalAlignment="Center">
                    <Run Text="设备须已进入 " />
                    <Run Text="Download 模式" Foreground="#333333" FontWeight="Medium" />
                    <Run Text="（音量减 + Home + 电源）。勾选设备后点击&quot;选择固件&quot;为其批量分配固件，不同设备可独立分配不同固件。" />
                </TextBlock>
            </StackPanel>
        </Border>

        <Grid Grid.Row="2" Background="#F5F5F5">
            <Border Margin="14,14,14,0"
                    Background="White"
                    BorderBrush="{StaticResource OdinBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="3.5"
                    VerticalAlignment="Top">
                <DataGrid ItemsSource="{Binding Devices}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          CanUserResizeRows="False"
                          CanUserResizeColumns="False"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          RowHeaderWidth="0"
                          IsReadOnly="False"
                          EnableRowVirtualization="True"
                          EnableColumnVirtualization="True"
                          HorizontalGridLinesBrush="#80E0E0E0"
                          BorderThickness="0">
                    <DataGrid.Resources>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Height" Value="39" />
                            <Setter Property="Background" Value="#FAFAFA" />
                            <Setter Property="BorderBrush" Value="#E0E0E0" />
                            <Setter Property="BorderThickness" Value="0,0,0,1" />
                            <Setter Property="FontSize" Value="10.5" />
                            <Setter Property="FontWeight" Value="Medium" />
                            <Setter Property="Foreground" Value="#333333" />
                            <Setter Property="HorizontalContentAlignment" Value="Center" />
                            <Setter Property="Padding" Value="0" />
                        </Style>
                        <Style TargetType="DataGridRow">
                            <Setter Property="Height" Value="43" />
                            <Setter Property="Background" Value="White" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                    <Setter Property="Background" Value="#0D5C82FD" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                        <Style TargetType="DataGridCell">
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="VerticalContentAlignment" Value="Center" />
                            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                            <Setter Property="Background" Value="Transparent" />
                        </Style>
                    </DataGrid.Resources>
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Width="66.5">
                            <DataGridTemplateColumn.HeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Height" Value="39" />
                                    <Setter Property="Background" Value="#FAFAFA" />
                                    <Setter Property="BorderBrush" Value="#E0E0E0" />
                                    <Setter Property="BorderThickness" Value="0,0,0,1" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="HorizontalContentAlignment" Value="Center" />
                                </Style>
                            </DataGridTemplateColumn.HeaderStyle>
                            <DataGridTemplateColumn.CellStyle>
                                <Style TargetType="DataGridCell">
                                    <Setter Property="BorderThickness" Value="0" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="HorizontalContentAlignment" Value="Center" />
                                    <Setter Property="VerticalContentAlignment" Value="Center" />
                                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                    <Setter Property="Background" Value="Transparent" />
                                </Style>
                            </DataGridTemplateColumn.CellStyle>
                            <DataGridTemplateColumn.HeaderTemplate>
                                <DataTemplate>
                                    <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                        <CheckBox Style="{StaticResource OdinHeaderCheckBoxStyle}"
                                                  IsChecked="{Binding DataContext.IsSelectAll, RelativeSource={RelativeSource AncestorType=DataGrid}, Mode=TwoWay}" />
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.HeaderTemplate>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                        <CheckBox Style="{StaticResource OdinTableCheckBoxStyle}"
                                                  IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="序号" Width="78" IsReadOnly="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DisplayIndex, StringFormat={}{0:00}}" Style="{StaticResource OdinCellTextStyle}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="设备" Width="360" IsReadOnly="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Serial}" Style="{StaticResource OdinCellTextStyle}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="连接方式" Width="105" IsReadOnly="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Height="21" Padding="8.75,0" Background="#1A5C82FD" CornerRadius="10.5" HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding ConnectionType}" FontSize="10.5" FontWeight="Medium" Foreground="#5C82FD" VerticalAlignment="Center" />
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="BL" Width="65" Binding="{Binding BlFileName}" ElementStyle="{StaticResource OdinMutedCellTextStyle}" IsReadOnly="True" />
                        <DataGridTextColumn Header="AP" Width="66" Binding="{Binding ApFileName}" ElementStyle="{StaticResource OdinMutedCellTextStyle}" IsReadOnly="True" />
                        <DataGridTextColumn Header="CSC" Width="76" Binding="{Binding CscFileName}" ElementStyle="{StaticResource OdinMutedCellTextStyle}" IsReadOnly="True" />
                        <DataGridTextColumn Header="USERDATA" Width="110" Binding="{Binding UserdataFileName}" ElementStyle="{StaticResource OdinMutedCellTextStyle}" IsReadOnly="True" />
                        <DataGridTextColumn Header="状态 / 进度" Width="110" Binding="{Binding StatusText}" ElementStyle="{StaticResource OdinMutedCellTextStyle}" IsReadOnly="True" />
                        <DataGridTextColumn Header="操作" Width="78" Binding="{Binding OperationText}" ElementStyle="{StaticResource OdinMutedCellTextStyle}" IsReadOnly="True" />
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <Border Background="#66FFFFFF" Visibility="{Binding IsLoading, Converter={StaticResource VisibilityBoolConverter}}">
                <TextBlock Text="正在扫描 Download 模式设备..."
                           FontSize="14"
                           Foreground="#333333"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
            </Border>
        </Grid>

        <Border Grid.Row="3" Background="White" BorderBrush="{StaticResource OdinBorderBrush}" BorderThickness="0,1,0,0">
            <TextBlock Margin="14,8.75,14,0"
                       Text="{Binding SummaryText}"
                       FontSize="10.5"
                       Foreground="{StaticResource OdinMutedBrush}" />
        </Border>
    </Grid>
</UserControl>
